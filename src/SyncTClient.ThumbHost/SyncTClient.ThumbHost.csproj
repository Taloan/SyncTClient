<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>synctthumbhost</AssemblyName>
    <RootNamespace>SyncTClient.ExplorerProvider</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dieselbe Umsetzung wie die DLL, nur ausserhalb des Explorers.
         OneDrive macht es genauso: Ueberlagerungssymbole als DLL im Prozess,
         Vorschauen in einem eigenen Programm. -->
    <Compile Include="..\SyncTClient.ExplorerProvider\ThumbnailProvider.cs" Link="ThumbnailProvider.cs" />

    <!-- Der Anbieter verweist darauf. Ohne diese Datei uebersetzt er hier
         nicht, obwohl das Kontextmenue selbst nur in der DLL gebraucht wird. -->
    <Compile Include="..\SyncTClient.ExplorerProvider\ContextMenu.cs" Link="ContextMenu.cs" />
  </ItemGroup>

</Project>
