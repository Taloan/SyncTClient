<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SyncTClient.Mount</RootNamespace>
    <AssemblyName>synctmount</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Fest auf win-x64, aus demselben Grund wie beim Client, und aus
         einem zweiten: dieses Projekt ist eine Exe. Fuer eine Exe unter den
         Verweisen rechnet das SDK den Ausgabepfad mit der RuntimeIdentifier
         des verweisenden Projekts aus, uebersetzt sie aber ohne. Beim
         Veroeffentlichen mit win-x64 verwies der Client damit auf
         bin\Release\...\win-x64\synctmount.dll, und die war drei Tage alt:
         zwei Methoden fehlten, die laengst im Quelltext standen. Mit fester
         RuntimeIdentifier fallen Pfad und Uebersetzung wieder zusammen. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dieselbe Umsetzung wie die DLL. Der laufende Client meldet die Klasse
         zur Laufzeit an, so wie es Microsofts CloudMirror-Beispiel tut. -->
    <Compile Include="..\SyncTClient.ExplorerProvider\ThumbnailProvider.cs" Link="ThumbnailProvider.cs" />

    <!-- Der Einstiegspunkt der DLL bedient beide Klassen und nennt deshalb
         auch die des Kontextmenues. Sie kommt hier nie zum Einsatz, denn der
         Client ruft DllGetClassObject nicht auf; uebersetzen muss es sich
         trotzdem. -->
    <Compile Include="..\SyncTClient.ExplorerProvider\ContextMenu.cs" Link="ContextMenu.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SyncTClient.Bep\SyncTClient.Bep.csproj" />
    <ProjectReference Include="..\SyncTClient.Vfs\SyncTClient.Vfs.csproj" />
  </ItemGroup>

</Project>
