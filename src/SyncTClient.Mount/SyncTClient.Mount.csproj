<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SyncTClient.Mount</RootNamespace>
    <AssemblyName>synctmount</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dieselbe Umsetzung wie die DLL. Der laufende Client meldet die Klasse
         zur Laufzeit an, so wie es Microsofts CloudMirror-Beispiel tut. -->
    <Compile Include="..\SyncTClient.ThumbProvider\ThumbnailProvider.cs" Link="ThumbnailProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SyncTClient.Bep\SyncTClient.Bep.csproj" />
    <ProjectReference Include="..\SyncTClient.Vfs\SyncTClient.Vfs.csproj" />
  </ItemGroup>

</Project>
