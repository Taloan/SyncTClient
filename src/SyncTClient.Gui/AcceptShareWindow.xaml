<Window x:Class="SyncTClient.Gui.AcceptShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Menu.Connect}" Height="660" Width="780"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Flaeche}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
      <TextBlock x:Name="SubTitleText" Foreground="{DynamicResource Gedaempft}" FontSize="11" Margin="0,2,0,10" />

      <Label Content="{DynamicResource S.Accept.LocalFolder}" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{DynamicResource S.Browse}" Padding="10,3"
                Margin="6,0,0,0" Click="OnBrowse" />
        <TextBox x:Name="LocalPathBox" VerticalContentAlignment="Center" />
      </DockPanel>
      <TextBlock Foreground="{DynamicResource Gedaempft}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                 Text="{DynamicResource S.Accept.PathHint}" />

      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <StackPanel Width="330">
          <Label Content="{DynamicResource S.Accept.ModeQuestion}" />
          <ComboBox x:Name="ModeBox" SelectionChanged="OnModeChanged">
            <ComboBoxItem Content="{DynamicResource S.Mode.OnDemand}" />
            <ComboBoxItem Content="{DynamicResource S.Mode.Always}" />
          </ComboBox>
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="ModeHint" Foreground="{DynamicResource Gedaempft}" FontSize="11" TextWrapping="Wrap"
                 Margin="0,6,0,0" />
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,14,0,4">
      <TextBlock DockPanel.Dock="Left" Text="{DynamicResource S.Accept.TreeQuestion}"
                 FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.None}" Padding="10,3" Click="OnSelectNone" Margin="0" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.All}" Padding="10,3" Click="OnSelectAll" Margin="0,0,6,0" />
      <TextBlock x:Name="TreeStatus" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource Gedaempft}" />
    </DockPanel>

    <Border Grid.Row="2" BorderBrush="{DynamicResource Rahmen}" BorderThickness="1">
      <TreeView x:Name="FolderTree" BorderThickness="0">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        IsThreeState="False" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Summary}" Margin="10,0,0,0"
                         Foreground="{DynamicResource Gedaempft}" VerticalAlignment="Center" />
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Border>

    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Menu.Connect}" Padding="14,4" Click="OnAccept"
              IsDefault="True" Margin="0" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Cancel}" Padding="14,4" IsCancel="True" Margin="0,0,6,0" />
      <TextBlock x:Name="Hint" Foreground="{DynamicResource Gedaempft}" VerticalAlignment="Center" TextWrapping="Wrap"
                 Text="{DynamicResource S.Accept.Hint}" />
    </DockPanel>
  </Grid>
</Window>
