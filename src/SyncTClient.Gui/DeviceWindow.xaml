<Window x:Class="SyncTClient.Gui.DeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dieses Gerät" Height="420" Width="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <TextBlock Text="Eigene Device-ID" FontWeight="SemiBold" />
    <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,8"
               Text="Diese Kennung auf der Gegenstelle als Gerät eintragen und die gewünschten Ordner damit teilen. Danach erscheinen sie in der Übersicht als angeboten." />
    <TextBox x:Name="OwnIdBox" IsReadOnly="True" FontFamily="Consolas"
             TextWrapping="Wrap" Padding="8" />
    <Button Content="In die Zwischenablage" Click="OnCopyId" Padding="10,4"
            HorizontalAlignment="Left" Margin="0,8,0,0" />

    <TextBlock Text="Konfigurationsdatei" FontWeight="SemiBold" Margin="0,20,0,2" />
    <TextBox x:Name="ConfigPathBox" IsReadOnly="True" Padding="6" />

    <TextBlock Text="Vorschaubilder" FontWeight="SemiBold" Margin="0,20,0,2" />
    <TextBlock x:Name="ThumbInfo" Foreground="Gray" TextWrapping="Wrap" />

    <Button Content="Schließen" IsCancel="True" Padding="14,4"
            HorizontalAlignment="Right" Margin="0,24,0,0" />
  </StackPanel>
</Window>
