<Window x:Class="SyncTClient.Gui.DeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Main.Device}"
        Height="720" Width="920" MinHeight="520" MinWidth="740"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Flaeche}">

  <DockPanel Margin="16">

    <!-- Die Knöpfe stehen außerhalb des Rollbereichs. Sie dürfen nie
         weggescrollt sein, sonst käme man aus dem Fenster nur über das X
         heraus, und das ist kein Abbrechen. -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Save}"
              Padding="16,5" Margin="0" Click="OnSave" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Cancel}"
              Padding="16,5" Margin="0,0,6,0" IsCancel="True" />
      <TextBlock x:Name="Hint" Foreground="{DynamicResource Gedaempft}"
                 TextWrapping="Wrap" VerticalAlignment="Center" />
    </DockPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <DockPanel>

        <StackPanel x:Name="QrPanel" DockPanel.Dock="Right" Margin="24,0,0,0" VerticalAlignment="Top">
          <Border BorderBrush="{DynamicResource Rahmen}" BorderThickness="1"
                  Background="{DynamicResource Feld}" Padding="8">
            <Image x:Name="QrImage" Width="190" Height="190"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
          </Border>
          <TextBlock Width="208" TextAlignment="Center" TextWrapping="Wrap"
                     FontSize="11" Foreground="{DynamicResource Gedaempft}" Margin="0,6,0,0"
                     Text="{DynamicResource S.Device.ScanHint}" />
        </StackPanel>

        <StackPanel>
          <TextBlock Text="{DynamicResource S.Device.Name}" FontWeight="SemiBold" />
          <TextBox x:Name="DeviceNameBox" Padding="6" Margin="0,4,0,0" />
          <TextBlock Foreground="{DynamicResource Gedaempft}" TextWrapping="Wrap"
                     FontSize="11" Margin="0,0,0,16"
                     Text="{DynamicResource S.Device.NameHint}" />

          <TextBlock Text="{DynamicResource S.Device.OwnId}" FontWeight="SemiBold" />
          <TextBlock Foreground="{DynamicResource Gedaempft}" TextWrapping="Wrap" Margin="0,2,0,8"
                     Text="{DynamicResource S.Device.OwnIdHint}" />

          <!-- Kein Umbruch: die Kennung ist eine einzige Zeichenkette. In zwei
               Zeilen liest man sie nicht ab, sondern rät die Trennstelle. -->
          <TextBox x:Name="OwnIdBox" IsReadOnly="True" FontFamily="Consolas"
                   TextWrapping="NoWrap" Padding="8"
                   HorizontalScrollBarVisibility="Auto" />
          <Button Content="{DynamicResource S.Device.Copy}" Click="OnCopyId" Padding="10,4"
                  HorizontalAlignment="Left" Margin="0,8,0,0" />
          <TextBlock x:Name="CopyHint" Foreground="{DynamicResource Gedaempft}" Margin="0,6,0,0" />

          <TextBlock Text="{DynamicResource S.Device.ConfigFile}" FontWeight="SemiBold" Margin="0,20,0,2" />
          <TextBox x:Name="ConfigPathBox" IsReadOnly="True" Padding="6" />

          <!-- Wo die Indizes liegen und was sie belegen. Die Frage kommt
               spaetestens dann auf, wenn eine Platte voll wird, und dann
               soll man nicht suchen muessen. -->
          <TextBlock Text="{DynamicResource S.Device.DataDir}" FontWeight="SemiBold" Margin="0,20,0,2" />
          <TextBox x:Name="DataPathBox" IsReadOnly="True" Padding="6" />

          <TextBlock x:Name="DbSummary" Foreground="{DynamicResource Gedaempft}"
                     FontSize="11" Margin="0,8,0,4" />

          <Border BorderBrush="{DynamicResource Rahmen}" BorderThickness="1">
            <ItemsControl x:Name="DbList" Margin="8,6,8,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontSize="11"
                               MinWidth="70" TextAlignment="Right"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding File}" FontSize="11"
                               FontFamily="Consolas" Margin="12,0,12,0"
                               Foreground="{DynamicResource Gedaempft}" />
                    <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </DockPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
