<Window x:Class="SyncTClient.Gui.DeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Main.Device}" Height="560" Width="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Flaeche}">
  <DockPanel Margin="16">

    <StackPanel x:Name="QrPanel" DockPanel.Dock="Right" Margin="20,0,0,0" VerticalAlignment="Top">
      <Border BorderBrush="{DynamicResource Rahmen}" BorderThickness="1" Background="{DynamicResource Feld}" Padding="8">
        <Image x:Name="QrImage" Width="190" Height="190"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />
      </Border>
      <TextBlock Width="208" TextAlignment="Center" TextWrapping="Wrap"
                 FontSize="11" Foreground="{DynamicResource Gedaempft}" Margin="0,6,0,0"
                 Text="{DynamicResource S.Device.ScanHint}" />
    </StackPanel>

    <StackPanel>
      <TextBlock Text="{DynamicResource S.Device.Name}" FontWeight="SemiBold" />
      <TextBox x:Name="DeviceNameBox" Padding="6" Margin="0,4,0,0"
               LostFocus="OnDeviceNameChanged" />
      <TextBlock Foreground="{DynamicResource Gedaempft}" TextWrapping="Wrap"
                 FontSize="11" Margin="0,0,0,16"
                 Text="{DynamicResource S.Device.NameHint}" />

      <TextBlock Text="{DynamicResource S.Device.OwnId}" FontWeight="SemiBold" />
      <TextBlock Foreground="{DynamicResource Gedaempft}" TextWrapping="Wrap" Margin="0,2,0,8"
                 Text="{DynamicResource S.Device.OwnIdHint}" />
      <TextBox x:Name="OwnIdBox" IsReadOnly="True" FontFamily="Consolas"
               TextWrapping="Wrap" Padding="8" />
      <Button Content="{DynamicResource S.Device.Copy}" Click="OnCopyId" Padding="10,4"
              HorizontalAlignment="Left" Margin="0,8,0,0" />
      <TextBlock x:Name="CopyHint" Foreground="{DynamicResource Gedaempft}" Margin="0,6,0,0" />

      <TextBlock Text="{DynamicResource S.Device.ConfigFile}" FontWeight="SemiBold" Margin="0,20,0,2" />
      <TextBox x:Name="ConfigPathBox" IsReadOnly="True" Padding="6" />

      <TextBlock Text="{DynamicResource S.Device.StartGroup}" FontWeight="SemiBold" Margin="0,20,0,2" />

      <CheckBox x:Name="AutostartBox" Margin="0,6,0,0"
                Content="{DynamicResource S.Device.Autostart}"
                Checked="OnAutostartChanged" Unchecked="OnAutostartChanged" />
      <CheckBox x:Name="StartMinimizedBox" Margin="0,6,0,0"
                Content="{DynamicResource S.Device.StartMinimized}"
                Checked="OnWindowOptionChanged" Unchecked="OnWindowOptionChanged" />
      <CheckBox x:Name="CloseToTrayBox" Margin="0,6,0,0"
                Content="{DynamicResource S.Device.CloseToTray}"
                Checked="OnWindowOptionChanged" Unchecked="OnWindowOptionChanged" />

      <TextBlock Foreground="{DynamicResource Gedaempft}" TextWrapping="Wrap"
                 FontSize="11" Margin="0,8,0,0"
                 Text="{DynamicResource S.Device.StartHint}" />
      <TextBlock x:Name="Hint" Foreground="{DynamicResource Gedaempft}" TextWrapping="Wrap"
                 Margin="0,6,0,0" />

      <Button Content="{DynamicResource S.Close}" IsCancel="True" Padding="14,4"
              HorizontalAlignment="Right" Margin="0,24,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
