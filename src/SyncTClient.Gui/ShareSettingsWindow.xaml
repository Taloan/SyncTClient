<Window x:Class="SyncTClient.Gui.ShareSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Settings.Title}" Height="640" Width="760" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Flaeche}">
  <DockPanel Margin="14">

    <!-- Die Knoepfe bleiben stehen, auch wenn der Rest rollt. -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Save}" Padding="14,4" Click="OnSave" Margin="0" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Cancel}" Padding="14,4" IsCancel="True" Margin="0,0,6,0" />
      <TextBlock x:Name="SaveHint" Foreground="{DynamicResource Gedaempft}" VerticalAlignment="Center"
                 TextWrapping="Wrap" Text="{DynamicResource S.Share.SaveHint}" />
    </DockPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="SubTitleText" Foreground="{DynamicResource Gedaempft}"
                   FontSize="11" Margin="0,2,0,10" />

        <Label Content="{DynamicResource S.Col.Name}" />
        <TextBox x:Name="LabelBox" />
        <TextBlock Foreground="{DynamicResource Gedaempft}" TextWrapping="Wrap"
                   FontSize="11" Margin="0,0,0,8"
                   Text="{DynamicResource S.Share.LabelHint}" />

        <Label Content="{DynamicResource S.Share.LocalPath}" />
        <TextBox x:Name="LocalPathBox" />

        <Label Content="{DynamicResource S.Col.Mode}" />
        <ComboBox x:Name="ModeBox" SelectionChanged="OnModeChanged">
          <ComboBoxItem Content="{DynamicResource S.Mode.OnDemand}" />
          <ComboBoxItem Content="{DynamicResource S.Mode.Always}" />
        </ComboBox>

        <StackPanel Orientation="Horizontal">
          <StackPanel Width="220" x:Name="CopiesPanel">
            <Label Content="{DynamicResource S.Share.MinCopies}" />
            <TextBox x:Name="MinimumCopiesBox">
              <TextBox.ToolTip>
                <TextBlock Text="{DynamicResource S.Share.CopiesHint}" TextWrapping="Wrap" MaxWidth="420" />
              </TextBox.ToolTip>
            </TextBox>
          </StackPanel>
          <StackPanel Margin="20,0,0,0" VerticalAlignment="Bottom">
            <CheckBox x:Name="ThumbsBox" Content="{DynamicResource S.Share.Thumbs}" Margin="0,0,0,12" />
          </StackPanel>
        </StackPanel>

        <Label Content="{DynamicResource S.Share.Conflict}" />
        <ComboBox x:Name="ConflictBox" Width="360" HorizontalAlignment="Left">
          <ComboBox.ToolTip>
            <TextBlock Text="{DynamicResource S.Share.ConflictHint}" TextWrapping="Wrap" MaxWidth="420" />
          </ComboBox.ToolTip>
          <ComboBoxItem Content="{DynamicResource S.Conflict.KeepBoth}" />
          <ComboBoxItem Content="{DynamicResource S.Conflict.Newer}" />
          <ComboBoxItem Content="{DynamicResource S.Conflict.Older}" />
          <ComboBoxItem Content="{DynamicResource S.Conflict.Local}" />
          <ComboBoxItem Content="{DynamicResource S.Conflict.Remote}" />
        </ComboBox>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <CheckBox x:Name="KeepVersionsBox" Content="{DynamicResource S.Share.KeepVersions}"
                    VerticalAlignment="Center" Checked="OnKeepVersionsChanged"
                    Unchecked="OnKeepVersionsChanged">
            <CheckBox.ToolTip>
              <TextBlock Text="{DynamicResource S.Share.VersionsHint}" TextWrapping="Wrap" MaxWidth="420" />
            </CheckBox.ToolTip>
          </CheckBox>
          <TextBlock x:Name="VersionDaysLabel" Text="{DynamicResource S.Share.VersionDays}"
                     VerticalAlignment="Center" Margin="20,0,6,0" />
          <TextBox x:Name="VersionDaysBox" Width="60" VerticalAlignment="Center">
            <TextBox.ToolTip>
              <TextBlock Text="{DynamicResource S.Share.VersionDaysHint}" TextWrapping="Wrap" MaxWidth="420" />
            </TextBox.ToolTip>
          </TextBox>
        </StackPanel>

        <DockPanel Margin="0,14,0,6" MinHeight="26">
          <TextBlock DockPanel.Dock="Left" Text="{DynamicResource S.Share.TreeQuestion}"
                     FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button DockPanel.Dock="Right" Content="{DynamicResource S.None}" Padding="10,3" Click="OnSelectNone" Margin="0" />
          <Button DockPanel.Dock="Right" Content="{DynamicResource S.All}" Padding="10,3" Click="OnSelectAll" Margin="0,0,6,0" />
          <TextBlock x:Name="TreeStatus" VerticalAlignment="Center" Margin="10,0"
                     Foreground="{DynamicResource Gedaempft}" />
        </DockPanel>

        <Border BorderBrush="{DynamicResource Rahmen}" BorderThickness="1" MinHeight="240">
          <TreeView x:Name="FolderTree" BorderThickness="0">
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="0,1">
                  <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            IsThreeState="False" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Summary}" Margin="10,0,0,0"
                             Foreground="{DynamicResource Gedaempft}" VerticalAlignment="Center" />
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
