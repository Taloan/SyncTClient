<Window x:Class="SyncTClient.Gui.ShareSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Settings.Title}" Height="640" Width="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Flaeche}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
      <TextBlock x:Name="SubTitleText" Foreground="{DynamicResource Gedaempft}"
                 FontSize="11" Margin="0,2,0,10" />

      <Label Content="{DynamicResource S.Share.LocalPath}" />
      <TextBox x:Name="LocalPathBox" />

      <Label Content="{DynamicResource S.Col.Mode}" />
      <ComboBox x:Name="ModeBox" SelectionChanged="OnModeChanged">
        <ComboBoxItem Content="{DynamicResource S.Mode.OnDemand}" />
        <ComboBoxItem Content="{DynamicResource S.Mode.Always}" />
      </ComboBox>

      <StackPanel Orientation="Horizontal">
        <StackPanel Width="240" x:Name="CopiesPanel">
          <Label Content="{DynamicResource S.Share.MinCopies}" />
          <TextBox x:Name="MinimumCopiesBox" />
        </StackPanel>
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Bottom">
          <CheckBox x:Name="ThumbsBox" Content="{DynamicResource S.Share.Thumbs}" Margin="0,0,0,12" />
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="CacheHint" Foreground="{DynamicResource Gedaempft}" TextWrapping="Wrap" Margin="0,4,0,4" />
      <TextBlock Foreground="{DynamicResource Gedaempft}" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="{DynamicResource S.Share.CopiesHint}" />
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,8,0,4">
      <TextBlock DockPanel.Dock="Left" Text="{DynamicResource S.Share.TreeQuestion}"
                 FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.None}" Padding="10,3" Click="OnSelectNone" Margin="0" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.All}" Padding="10,3" Click="OnSelectAll" Margin="0,0,6,0" />
      <TextBlock x:Name="TreeStatus" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource Gedaempft}" />
    </DockPanel>

    <Border Grid.Row="2" BorderBrush="{DynamicResource Rahmen}" BorderThickness="1">
      <TreeView x:Name="FolderTree" BorderThickness="0">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
              <!-- IsThreeState bleibt aus: der unbestimmte Zustand ergibt
                   sich aus den Kindern, anklicken laesst er sich nicht. -->
              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        IsThreeState="False" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Summary}" Margin="10,0,0,0"
                         Foreground="{DynamicResource Gedaempft}" VerticalAlignment="Center" />
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Border>

    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Save}" Padding="14,4" Click="OnSave" Margin="0" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Cancel}" Padding="14,4" IsCancel="True" Margin="0,0,6,0" />
      <TextBlock x:Name="SaveHint" Foreground="{DynamicResource Gedaempft}" VerticalAlignment="Center"
                 Text="{DynamicResource S.Share.SaveHint}" />
    </DockPanel>
  </Grid>
</Window>
