<Window x:Class="SyncTClient.Gui.ShareSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" Height="640" Width="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

      <Label Content="Lokaler Pfad" />
      <TextBox x:Name="LocalPathBox" />

      <Label Content="Modus" />
      <ComboBox x:Name="ModeBox" SelectionChanged="OnModeChanged">
        <ComboBoxItem Content="Bei Bedarf herunterladen (Platzhalter)" />
        <ComboBoxItem Content="Vollständig lokal bereithalten" />
      </ComboBox>

      <StackPanel Orientation="Horizontal">
        <StackPanel Width="200" x:Name="CachePanel">
          <Label Content="Cache-Budget (MB)" />
          <TextBox x:Name="CacheBudgetBox" />
        </StackPanel>
        <StackPanel Width="200" Margin="16,0,0,0" x:Name="CopiesPanel">
          <Label Content="Erst freigeben ab … Kopien" />
          <TextBox x:Name="MinimumCopiesBox" />
        </StackPanel>
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Bottom">
          <CheckBox x:Name="ThumbsBox" Content="Vorschaubilder bei Bedarf erzeugen" Margin="0,0,0,6" />
          <CheckBox x:Name="AutoStartBox" Content="Beim Start automatisch hochfahren" Margin="0,0,0,12" />
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="CacheHint" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4" />
      <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Verdrängen heißt Bytes wegwerfen. Eine Datei wird erst freigegeben, wenn so viele andere Knoten sie vollständig führen. Gegen einen Server ist 1 richtig; wer mehrere Knoten hat, kann 2 verlangen. 0 schaltet die Prüfung ab." />
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,8,0,4">
      <TextBlock DockPanel.Dock="Left" Text="Was soll überhaupt erscheinen?"
                 FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right" Content="Nichts" Padding="10,3" Click="OnSelectNone" Margin="0" />
      <Button DockPanel.Dock="Right" Content="Alles" Padding="10,3" Click="OnSelectAll" Margin="0,0,6,0" />
      <TextBlock x:Name="TreeStatus" VerticalAlignment="Center" Margin="10,0" Foreground="Gray" />
    </DockPanel>

    <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1">
      <TreeView x:Name="FolderTree" BorderThickness="0">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
              <!-- IsThreeState bleibt aus: der unbestimmte Zustand ergibt
                   sich aus den Kindern, anklicken laesst er sich nicht. -->
              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        IsThreeState="False" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Summary}" Margin="10,0,0,0"
                         Foreground="Gray" VerticalAlignment="Center" />
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Border>

    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Speichern" Padding="14,4" Click="OnSave" Margin="0" />
      <Button DockPanel.Dock="Right" Content="Abbrechen" Padding="14,4" IsCancel="True" Margin="0,0,6,0" />
      <TextBlock x:Name="SaveHint" Foreground="Gray" VerticalAlignment="Center"
                 Text="Änderungen greifen, wenn die Freigabe neu gestartet wird." />
    </DockPanel>
  </Grid>
</Window>
