<Window x:Class="SyncTClient.Gui.OutstandingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Open.Title}"
        Width="760" Height="480" MinWidth="480" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Flaeche}">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
      <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource Gedaempft}"
                 TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
    </StackPanel>

    <Button DockPanel.Dock="Bottom" Content="{DynamicResource S.Close}" Padding="12,4" IsCancel="True"
            HorizontalAlignment="Right" Margin="0,10,0,0" />

    <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource RahmenFein}"
              BorderBrush="{DynamicResource Rahmen}" BorderThickness="1" RowHeight="24">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{DynamicResource S.Open.Name}" Width="*" MinWidth="200"
                            Binding="{Binding Name}" />
        <DataGridTextColumn Header="{DynamicResource S.Open.Size}" Width="Auto" MinWidth="90"
                            Binding="{Binding Size}" />
        <DataGridTextColumn Header="{DynamicResource S.Open.Reason}" Width="Auto" MinWidth="200"
                            Binding="{Binding Reason}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
