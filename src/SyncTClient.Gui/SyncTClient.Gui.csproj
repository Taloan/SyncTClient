<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>

    <!-- Nur wegen NotifyIcon: ein Symbol im Infobereich hat WPF nicht. -->
    <UseWindowsForms>true</UseWindowsForms>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SyncTClient.Gui</RootNamespace>
    <AssemblyName>SyncTClient</AssemblyName>
    <ApplicationIcon>SyncTClient.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Windows Forms braechte sonst System.Drawing und System.Windows.Forms als
    globale Usings mit. Zusammen mit System.Windows waeren Application,
    MessageBox, Clipboard, Label und TextBox in jeder Datei mehrdeutig, auch in
    denen, die von NotifyIcon nichts wissen wollen. Wer es braucht, sagt es
    ausdruecklich per Alias.
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SyncTClient.Bep\SyncTClient.Bep.csproj" />
    <ProjectReference Include="..\SyncTClient.Mount\SyncTClient.Mount.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!--
    Dieses Programm ist 64-Bit, und das ist keine Geschmacksfrage.

    Ein 32-Bit-Prozess schreibt unter HKLM\SOFTWARE nach WOW6432Node. Dort
    sucht der Explorer weder den Sync-Root noch die Vorschau-Erweiterung, und
    die native Vorschau-DLL gibt es ohnehin nur als x64. Ein x86-Build
    startet, tut aber nichts von dem, wofuer es das Programm gibt.

    Der Fehler faellt sonst erst beim Ausprobieren des fertigen Pakets auf.
  -->
  <ItemGroup>
    <!-- Zusaetzlich zum ApplicationIcon: nur aus einer eingebetteten
         Ressource laesst sich die passende Groesse auswaehlen. Das Zeichen im
         Infobereich braucht 16 oder 32 Punkte, je nach Bildschirm. -->
    <Resource Include="SyncTClient.ico" />

    <!-- Je Zustand ein gezeichnetes Symbol. Erzeugt von tools/make-icon.ps1
         aus den stc2-*.png-Vorlagen. -->
    <Resource Include="Status-Ok.ico" />
    <Resource Include="Status-Work.ico" />
    <Resource Include="Status-Pause.ico" />
    <Resource Include="Status-Unknown.ico" />
    <Resource Include="Status-Error.ico" />
  </ItemGroup>

  <Target Name="NurX64" BeforeTargets="Build"
          Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64'">
    <Error Text="RuntimeIdentifier ist &quot;$(RuntimeIdentifier)&quot;. SyncTClient laeuft nur als win-x64 -- siehe die Anmerkung in dieser Projektdatei." />
  </Target>

  <!--
    Die Vorschau-DLL gehoert in den Veroeffentlichungsordner.

    Sie ist ein eigenes NativeAOT-Projekt, das niemand referenziert. Ohne
    diesen Schritt landet sie nirgends, und auf einem fremden Rechner gibt es
    weder Vorschaubilder noch Kontextmenue. Das Programm sucht sie zuerst neben
    der EXE; genau dorthin wird sie gelegt.

    Nur beim Veroeffentlichen, nicht bei jedem Build: waehrend der Entwicklung
    laedt der Explorer die DLL aus ihrem eigenen Ordner und haelt sie fest.
    Ein Kopierschritt bei jedem Build wuerde deshalb regelmaessig scheitern.

    Schlaegt das Veroeffentlichen fehl, etwa weil NativeAOT die
    C++-Werkzeuge nicht findet, bricht der Lauf ab. Ein Paket, dem sie fehlt, sieht
    vollstaendig aus und ist es nicht.
  -->
  <Target Name="VorschauDllMitnehmen" AfterTargets="Publish">
    <PropertyGroup>
      <VorschauProjekt>$(MSBuildThisFileDirectory)..\SyncTClient.ThumbProvider\SyncTClient.ThumbProvider.csproj</VorschauProjekt>
      <VorschauDll>$(MSBuildThisFileDirectory)..\SyncTClient.ThumbProvider\bin\$(Configuration)\net10.0-windows\win-x64\publish\synctthumbs.dll</VorschauDll>
    </PropertyGroup>

    <Exec Command="dotnet publish &quot;$(VorschauProjekt)&quot; -c $(Configuration) -r win-x64 --nologo" />

    <Error Condition="!Exists('$(VorschauDll)')"
           Text="synctthumbs.dll wurde nicht erzeugt. Ohne sie gibt es im veroeffentlichten Programm keine Vorschaubilder und kein Kontextmenue." />

    <Copy SourceFiles="$(VorschauDll)" DestinationFolder="$(PublishDir)" />
  </Target>

  <!--
    Beim ersten Bauen auf einem Rechner gibt es die Vorschau-DLL noch nicht.

    Sie entsteht nur beim Veroeffentlichen ihres eigenen Projekts; NativeAOT
    laesst sich nicht anders erzeugen. Wer die Projektmappe uebersetzt und
    startet, findet unter Einstellungen deshalb zwei Striche und einen
    gesperrten Knopf, ohne einen Hinweis darauf, dass ein Schritt fehlt, den
    die Projektmappe nirgends nennt.

    Nur wenn sie fehlt, und das ist der Unterschied zum Kopierschritt oben:
    liegt sie erst einmal da, laedt der Explorer sie von dort und haelt sie
    fest. Ein Erzeugen bei jedem Build wuerde daran regelmaessig scheitern.
    Wer die Erweiterung selbst aendert, veroeffentlicht sie also von Hand,
    und weiss dann auch, dass der Explorer dafuer erst loslassen muss.

    Immer Release: nur dort sucht ThumbnailProviderRegistration.FindLibrary
    im Entwicklungsbaum nach ihr.

    Schlaegt es fehl, etwa weil die C++-Werkzeuge fehlen, bleibt es bei einer
    Warnung. Das Programm laeuft dann ohne Vorschaubilder weiter, was beim
    Entwickeln zu verschmerzen ist; beim Veroeffentlichen bricht der Lauf
    weiterhin ab.
  -->
  <Target Name="VorschauDllBereitstellen" BeforeTargets="Build">
    <PropertyGroup>
      <VorschauDllRelease>$(MSBuildThisFileDirectory)..\SyncTClient.ThumbProvider\bin\Release\net10.0-windows\win-x64\publish\synctthumbs.dll</VorschauDllRelease>
      <VorschauDllReleaseX64>$(MSBuildThisFileDirectory)..\SyncTClient.ThumbProvider\bin\x64\Release\net10.0-windows\win-x64\publish\synctthumbs.dll</VorschauDllReleaseX64>

      <!-- Das Verzeichnis von vswhere.exe. Die NativeAOT-Werkzeuge suchen
           darueber den C++-Binder, und auf manchen Rechnern finden sie es
           nur, wenn es im Suchpfad steht; sonst bricht das Binden mit einer
           Meldung ab, die nach einem fehlenden Visual Studio aussieht,
           obwohl eines da ist. -->
      <VsInstallerVerzeichnis>$([System.Environment]::GetFolderPath(SpecialFolder.ProgramFilesX86))\Microsoft Visual Studio\Installer</VsInstallerVerzeichnis>
    </PropertyGroup>

    <Exec Condition="!Exists('$(VorschauDllRelease)') and !Exists('$(VorschauDllReleaseX64)')"
          Command="set &quot;PATH=%25PATH%25;$(VsInstallerVerzeichnis)&quot; &amp;&amp; dotnet publish &quot;$(MSBuildThisFileDirectory)..\SyncTClient.ThumbProvider\SyncTClient.ThumbProvider.csproj&quot; -c Release -r win-x64 --nologo"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
