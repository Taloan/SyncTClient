<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>

    <!-- Nur wegen NotifyIcon: ein Symbol im Infobereich hat WPF nicht. -->
    <UseWindowsForms>true</UseWindowsForms>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SyncTClient.Gui</RootNamespace>
    <AssemblyName>SyncTClient</AssemblyName>
    <ApplicationIcon>SyncTClient.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Windows Forms braechte sonst System.Drawing und System.Windows.Forms als
    globale Usings mit. Zusammen mit System.Windows waeren Application,
    MessageBox, Clipboard, Label und TextBox in jeder Datei mehrdeutig, auch in
    denen, die von NotifyIcon nichts wissen wollen. Wer es braucht, sagt es
    ausdruecklich per Alias.
  -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SyncTClient.Bep\SyncTClient.Bep.csproj" />
    <ProjectReference Include="..\SyncTClient.Mount\SyncTClient.Mount.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!--
    Dieses Programm ist 64-Bit, und das ist keine Geschmacksfrage.

    Ein 32-Bit-Prozess schreibt unter HKLM\SOFTWARE nach WOW6432Node. Dort
    sucht der Explorer weder den Sync-Root noch die Vorschau-Erweiterung, und
    die native Vorschau-DLL gibt es ohnehin nur als x64. Ein x86-Build
    startet, tut aber nichts von dem, wofuer es das Programm gibt.

    Der Fehler faellt sonst erst beim Ausprobieren des fertigen Pakets auf.
  -->
  <ItemGroup>
    <!-- Zusaetzlich zum ApplicationIcon: nur aus einer eingebetteten
         Ressource laesst sich die passende Groesse auswaehlen. Das Zeichen im
         Infobereich braucht 16 oder 32 Punkte, je nach Bildschirm. -->
    <Resource Include="SyncTClient.ico" />

    <!-- Das Programmsymbol im Kopf der Einstellungen. Nicht stc2.png:
         das hat 1254 Pixel Kante und wuerde die Anwendung um 1,1 MB
         schwerer machen, um 48 davon anzuzeigen. -->
    <Resource Include="Logo.png" />

    <!-- Je Zustand ein gezeichnetes Symbol. Erzeugt von tools/make-icon.ps1
         aus den stc2-*.png-Vorlagen. -->
    <Resource Include="Status-Ok.ico" />
    <Resource Include="Status-Work.ico" />
    <Resource Include="Status-Pause.ico" />
    <Resource Include="Status-Unknown.ico" />
    <Resource Include="Status-Error.ico" />
  </ItemGroup>

  <Target Name="NurX64" BeforeTargets="Build"
          Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64'">
    <Error Text="RuntimeIdentifier ist &quot;$(RuntimeIdentifier)&quot;. SyncTClient laeuft nur als win-x64 -- siehe die Anmerkung in dieser Projektdatei." />
  </Target>

  <!--
    Die Vorschau-DLL: wo sie herkommt und wohin sie gehoert.

    Sie ist ein eigenes NativeAOT-Projekt, das niemand referenziert. Es
    entsteht nur beim Veroeffentlichen; anders laesst sich NativeAOT nicht
    erzeugen. Daraus folgen zwei Schritte, die verschiedene Dinge tun und
    deshalb beide bleiben.

    Beide rufen denselben Befehl. Das Verzeichnis von vswhere.exe kommt dabei
    in den Suchpfad: die NativeAOT-Werkzeuge finden den C++-Binder auf
    manchen Rechnern nur so, und sonst bricht das Binden mit einer Meldung
    ab, die nach einem fehlenden Visual Studio aussieht, obwohl eines da ist.

    Immer Release, gleich in welcher Fassung das Programm gebaut wird: nur
    dort sucht ExplorerRegistration.FindLibrary im Entwicklungsbaum
    nach ihr. Je nach Plattformwahl liegt sie mit oder ohne x64-Zwischenstufe.
  -->
  <PropertyGroup>
    <VorschauProjekt>$(MSBuildThisFileDirectory)..\SyncTClient.ExplorerProvider\SyncTClient.ExplorerProvider.csproj</VorschauProjekt>
    <VorschauDllRelease>$(MSBuildThisFileDirectory)..\SyncTClient.ExplorerProvider\bin\Release\net10.0-windows\win-x64\publish\synctexplorer.dll</VorschauDllRelease>
    <VorschauDllReleaseX64>$(MSBuildThisFileDirectory)..\SyncTClient.ExplorerProvider\bin\x64\Release\net10.0-windows\win-x64\publish\synctexplorer.dll</VorschauDllReleaseX64>

    <VsInstallerVerzeichnis>$([System.Environment]::GetFolderPath(SpecialFolder.ProgramFilesX86))\Microsoft Visual Studio\Installer</VsInstallerVerzeichnis>
    <VorschauBefehl>set "PATH=%25PATH%25;$(VsInstallerVerzeichnis)" &amp;&amp; dotnet publish "$(VorschauProjekt)" -c Release -r win-x64 --nologo</VorschauBefehl>
  </PropertyGroup>

  <!--
    Erstens: beim ersten Bauen auf einem Rechner gibt es sie noch nicht.

    Wer die Projektmappe uebersetzt und startet, findet unter Einstellungen
    sonst zwei Striche und einen gesperrten Knopf, ohne einen Hinweis darauf,
    dass ein Schritt fehlt, den die Projektmappe nirgends nennt.

    Nur wenn sie fehlt: liegt sie erst einmal da, laedt der Explorer sie von
    dort und haelt sie fest. Ein Erzeugen bei jedem Build wuerde daran
    regelmaessig scheitern. Wer die Erweiterung selbst aendert,
    veroeffentlicht sie also von Hand und weiss dann auch, dass der Explorer
    dafuer erst loslassen muss.

    Schlaegt es fehl, bleibt es bei einer Warnung. Das Programm laeuft dann
    ohne Vorschaubilder weiter, was beim Entwickeln zu verschmerzen ist.
  -->
  <Target Name="VorschauDllBereitstellen" BeforeTargets="Build">
    <Exec Condition="!Exists('$(VorschauDllRelease)') and !Exists('$(VorschauDllReleaseX64)')"
          Command="$(VorschauBefehl)"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <!--
    Zweitens: in ein Paket gehoert sie hinein.

    Das Programm sucht sie zuerst neben der EXE; genau dorthin wird sie
    gelegt. Ohne diesen Schritt gibt es auf einem fremden Rechner weder
    Vorschaubilder noch Kontextmenue.

    Hier wird sie in jedem Fall neu erzeugt, nicht nur wenn sie fehlt: ein
    Paket soll die Fassung tragen, die zum uebrigen Programm gehoert, und
    nicht die, die zufaellig noch herumliegt.

    Fehlt sie danach, bricht der Lauf ab. Ein Paket ohne sie sieht
    vollstaendig aus und ist es nicht.
  -->
  <Target Name="VorschauDllMitnehmen" AfterTargets="Publish">
    <Exec Command="$(VorschauBefehl)" />

    <PropertyGroup>
      <VorschauDll Condition="Exists('$(VorschauDllRelease)')">$(VorschauDllRelease)</VorschauDll>
      <VorschauDll Condition="'$(VorschauDll)' == '' and Exists('$(VorschauDllReleaseX64)')">$(VorschauDllReleaseX64)</VorschauDll>
    </PropertyGroup>

    <Error Condition="'$(VorschauDll)' == ''"
           Text="synctexplorer.dll wurde nicht erzeugt. Ohne sie gibt es im veroeffentlichten Programm keine Vorschaubilder und kein Kontextmenue." />

    <Copy SourceFiles="$(VorschauDll)" DestinationFolder="$(PublishDir)" />
  </Target>

</Project>
