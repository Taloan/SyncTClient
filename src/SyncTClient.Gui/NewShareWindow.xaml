<Window x:Class="SyncTClient.Gui.NewShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.New.Title}"
        Height="520" Width="580"
        WindowStartupLocation="CenterOwner"
        MinWidth="520" MinHeight="440"
        Background="{DynamicResource Flaeche}">
  <!-- Aus einem Ordner, der hier schon liegt, wird eine Freigabe. Der
       Gegenweg zum Uebernehmen: dort kommt der Inhalt von aussen und der
       Ordner entsteht, hier steht der Ordner und der Inhalt geht hinaus. -->
  <DockPanel Margin="16">

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Cancel}" IsCancel="True" Margin="0" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Add}" Click="OnAdd" IsDefault="True" />
      <TextBlock />
    </DockPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,16,0">

        <TextBlock Text="{DynamicResource S.New.Folder}" FontWeight="SemiBold" />
        <TextBlock x:Name="PathText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                   Foreground="{DynamicResource Gedaempft}" Margin="0,2,0,10" />

        <Label Content="{DynamicResource S.New.Label}" />
        <TextBox x:Name="LabelBox" />

        <Label Content="{DynamicResource S.New.FolderId}" />
        <TextBox x:Name="FolderIdBox" FontFamily="Consolas" />
        <TextBlock Text="{DynamicResource S.New.FolderIdHint}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Gedaempft}" FontSize="11" Margin="0,2,0,10" />

        <Label Content="{DynamicResource S.New.Mode}" />
        <ComboBox x:Name="ModeBox" SelectedIndex="1">
          <ComboBoxItem Content="{DynamicResource S.New.ModeOnDemand}" />
          <ComboBoxItem Content="{DynamicResource S.New.ModeAlwaysLocal}" />
        </ComboBox>
        <TextBlock Text="{DynamicResource S.New.ModeHint}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Gedaempft}" FontSize="11" Margin="0,2,0,10" />

        <TextBlock Text="{DynamicResource S.New.Peers}" FontWeight="SemiBold" Margin="0,4,0,2" />
        <TextBlock Text="{DynamicResource S.New.PeersHint}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Gedaempft}" FontSize="11" Margin="0,0,0,6" />

        <TextBlock x:Name="NoPeersText" Text="{DynamicResource S.New.NoPeers}"
                   Foreground="{DynamicResource Gedaempft}" Visibility="Collapsed" Margin="0,0,0,6" />

        <Border BorderBrush="{DynamicResource Rahmen}" BorderThickness="1" MinHeight="80">
          <ItemsControl x:Name="PeerList" Margin="10,8,10,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Shared, Mode=TwoWay}" Margin="0,3">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ShortId}" Margin="10,0,0,0" FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource Gedaempft}" VerticalAlignment="Center" />
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <TextBlock x:Name="Hint" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{DynamicResource Warnung}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
