<Window x:Class="SyncTClient.Gui.ProgramSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Settings.Title}" Height="640" Width="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource Flaeche}">
  <Window.Resources>
    <Style x:Key="Gruppe" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Gedaempft}" />
      <Setter Property="Margin" Value="0,14,0,2" />
    </Style>
    <!-- Zwischenueberschrift innerhalb einer Gruppe. Kleiner als die
         Gruppe selbst, damit die Gliederung zwei Ebenen tragen kann. -->
    <Style x:Key="Kopfzeile" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sekundaer}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="Hinweis" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Gedaempft}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="16">

    <TextBlock Text="{DynamicResource S.Settings.LookGroup}" Style="{StaticResource Gruppe}" Margin="0,0,0,2" />

    <StackPanel Orientation="Horizontal">
      <StackPanel Width="200">
        <Label Content="{DynamicResource S.Settings.Language}" />
        <ComboBox x:Name="LanguageBox" SelectionChanged="OnLookChanged">
          <ComboBoxItem Content="{DynamicResource S.Settings.System}" />
          <ComboBoxItem Content="Deutsch" />
          <ComboBoxItem Content="English" />
        </ComboBox>
      </StackPanel>
      <StackPanel Width="200" Margin="16,0,0,0">
        <Label Content="{DynamicResource S.Settings.Theme}" />
        <ComboBox x:Name="ThemeBox" SelectionChanged="OnLookChanged">
          <ComboBoxItem Content="{DynamicResource S.Settings.System}" />
          <ComboBoxItem Content="{DynamicResource S.Settings.Light}" />
          <ComboBoxItem Content="{DynamicResource S.Settings.Dark}" />
        </ComboBox>
      </StackPanel>
    </StackPanel>

    <TextBlock Text="{DynamicResource S.Settings.StorageGroup}" Style="{StaticResource Gruppe}" />

    <!-- ================= Sicherheitsvorgabe ================= -->
    <TextBlock Text="{DynamicResource S.Settings.SafetyGroup}" Style="{StaticResource Kopfzeile}" Margin="0,4,0,0" />

    <StackPanel Width="200" HorizontalAlignment="Left">
      <Label Content="{DynamicResource S.Settings.Threshold}" />
      <TextBox x:Name="ThresholdBox" />
    </StackPanel>
    <TextBlock Style="{StaticResource Hinweis}" Text="{DynamicResource S.Settings.ThresholdHint}" />

    <!-- ================= Je Datentraeger ================= -->
    <!-- Grenzen und Bestand stehen in derselben Zeile. Ein Limit, das an
         anderer Stelle steht als die Belegung, laesst sich nicht beurteilen:
         2 GB sind auf einer halbleeren Platte nichts und auf einem kleinen
         Datentraeger alles. -->
    <TextBlock Text="{DynamicResource S.Settings.VolumeGroup}" Style="{StaticResource Kopfzeile}" Margin="0,16,0,0" />
    <TextBlock Style="{StaticResource Hinweis}" Text="{DynamicResource S.Settings.VolumeLead}" Margin="0,0,0,8" />

    <!-- Wie viele Zeilen es sind, entscheidet sich erst zur Laufzeit:
         Freigaben duerfen auf verschiedenen Laufwerken liegen. -->
    <ItemsControl x:Name="VolumeList">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="{DynamicResource S.Settings.LimitShort}" VerticalAlignment="Center" />
              <TextBox Text="{Binding MaxGb, UpdateSourceTrigger=PropertyChanged}"
                       Width="70" Margin="6,0,0,0" />
              <TextBlock Text="{DynamicResource S.Settings.KeepFreeShort}" VerticalAlignment="Center"
                         Margin="18,0,0,0" />
              <TextBox Text="{Binding MinFreeGb, UpdateSourceTrigger=PropertyChanged}"
                       Width="70" Margin="6,0,0,0" />
            </StackPanel>

            <TextBlock Style="{StaticResource Hinweis}" Text="{Binding EvictText}" TextWrapping="Wrap"
                       Margin="0,4,0,0" />
            <Button Content="{Binding ButtonText}" Padding="10,3" HorizontalAlignment="Left"
                    Margin="0,4,0,0" IsEnabled="{Binding CanRelease}"
                    Tag="{Binding Root}" Click="OnReleaseVolume" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock x:Name="NoVolumes" Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.NoVolumes}" />

    <!-- ================= Vorgabe ================= -->
    <TextBlock Text="{DynamicResource S.Settings.DefaultGroup}" Style="{StaticResource Kopfzeile}" Margin="0,10,0,0" />
    <TextBlock Style="{StaticResource Hinweis}" Text="{DynamicResource S.Settings.DefaultLead}" Margin="0,0,0,4" />

    <StackPanel Width="240" HorizontalAlignment="Left">
      <Label Content="{DynamicResource S.Settings.PerVolume}" />
      <TextBox x:Name="CacheBudgetBox" />
    </StackPanel>
    <TextBlock Style="{StaticResource Hinweis}" Text="{DynamicResource S.Settings.PerVolumeHint}" />

    <StackPanel Width="240" HorizontalAlignment="Left" Margin="0,10,0,0">
      <Label Content="{DynamicResource S.Settings.KeepFree}" />
      <TextBox x:Name="MinimumFreeBox" />
    </StackPanel>
    <TextBlock Style="{StaticResource Hinweis}" Text="{DynamicResource S.Settings.KeepFreeHint}" />

    <!-- Erzeugen, Bestand und Loeschen stehen beieinander. Das Kaestchen
         allein sagt nichts darueber, was bereits liegt, und ein Knopf am
         anderen Ende des Fensters gehoerte sichtbar nirgends hin. -->
    <TextBlock Text="{DynamicResource S.Settings.ThumbGroup}" Style="{StaticResource Kopfzeile}" Margin="0,16,0,0" />

    <CheckBox x:Name="ThumbsBox" Content="{DynamicResource S.Settings.Thumbs}" />
    <TextBlock Style="{StaticResource Hinweis}" Text="{DynamicResource S.Settings.ThumbsHint}" />

    <TextBlock x:Name="ThumbUsageText" Margin="0,10,0,0" TextWrapping="Wrap" />
    <Button x:Name="ClearButton" Content="{DynamicResource S.Settings.ClearThumbs}" Padding="10,3"
            HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnClearThumbnails" />

    <TextBlock Text="{DynamicResource S.Settings.DataGroup}" Style="{StaticResource Gruppe}" />

    <Label Content="{DynamicResource S.Settings.DataDir}" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Browse}" Padding="10,3"
              Margin="6,0,0,0" Click="OnBrowseHome" />
      <TextBox x:Name="HomeBox" VerticalContentAlignment="Center" />
    </DockPanel>
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.DataDirHint}" />

    <TextBlock Text="{DynamicResource S.Settings.NetGroup}" Style="{StaticResource Gruppe}" />

    <CheckBox x:Name="ListenBox" Content="{DynamicResource S.Settings.Listen}" Margin="0,4,0,0" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.ListenHint}" />

    <StackPanel Orientation="Horizontal">
      <StackPanel Width="240">
        <Label Content="{DynamicResource S.Settings.ListenPort}" />
        <TextBox x:Name="ListenPortBox" />
      </StackPanel>
      <StackPanel Width="200" Margin="16,0,0,0">
        <Label Content="{DynamicResource S.Settings.Parallelism}" />
        <TextBox x:Name="ParallelismBox" />
      </StackPanel>
    </StackPanel>

    <CheckBox x:Name="LocalDiscoveryBox" Margin="0,12,0,0"
              Content="{DynamicResource S.Settings.LocalDiscovery}" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.LocalDiscoveryHint}" />

    <CheckBox x:Name="AnnounceBox" Margin="0,12,0,0"
              Content="{DynamicResource S.Settings.Announce}" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.AnnounceHint}" />

    <CheckBox x:Name="DiscoveryBox" Margin="0,12,0,0"
              Content="{DynamicResource S.Settings.Lookup}" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.LookupHint}" />

    <Label Content="{DynamicResource S.Settings.Servers}" Margin="0,6,0,0" />
    <TextBox x:Name="DiscoveryServerBox" Height="66" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.ServersHint}" />

    <CheckBox x:Name="RelaysBox" Margin="0,12,0,0"
              Content="{DynamicResource S.Settings.Relays}" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.RelaysHint}" />

    <DockPanel Margin="0,18,0,0">
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Save}" Padding="14,4" Click="OnSave" Margin="0" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Cancel}" Padding="14,4" IsCancel="True" Margin="0,0,6,0" />
      <TextBlock x:Name="Hint" Foreground="{DynamicResource Gedaempft}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
  </StackPanel>
  </ScrollViewer>
</Window>
