<Window x:Class="SyncTClient.Gui.ProgramSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Settings.Title}" Height="640" Width="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" MinWidth="640" MinHeight="420"
        Background="{DynamicResource Flaeche}">
  <Window.Resources>
    <Style x:Key="Gruppe" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Gedaempft}" />
      <Setter Property="Margin" Value="0,14,0,2" />
    </Style>
    <!-- Zwischenueberschrift innerhalb einer Gruppe. Kleiner als die
         Gruppe selbst, damit die Gliederung zwei Ebenen tragen kann. -->
    <Style x:Key="Kopfzeile" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Sekundaer}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="Hinweis" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Gedaempft}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <!-- Rechts mehr Rand fuer die Bildlaufleiste. Das Fluent-Thema legt sie
       ueber den Inhalt, statt Platz fuer sie zu lassen. -->
  <StackPanel Margin="16,16,32,16">

    <!-- Wer wissen will, welche Fassung hier laeuft, sucht sie sonst in den
         Eigenschaften der Datei. Sie steht jetzt dort, wo man ohnehin
         nachsieht, wenn etwas nicht stimmt. -->
    <Border Background="{DynamicResource Feld}" BorderBrush="{DynamicResource Rahmen}"
            BorderThickness="1" Padding="14,12" Margin="0,0,0,4">
      <StackPanel Orientation="Horizontal">
        <Image Source="Logo.png" Width="48" Height="48" VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="SyncTClient" FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource Text}" />
          <TextBlock x:Name="VersionText" FontSize="11" Margin="0,2,0,0"
                     Foreground="{DynamicResource Gedaempft}" />
          <TextBlock FontSize="11" Margin="0,4,0,0">
            <Hyperlink x:Name="HomeLink" Click="OnOpenHome"
                       ToolTip="{DynamicResource S.Settings.HomeTip}">
              <Run x:Name="HomeText" />
            </Hyperlink>
          </TextBlock>
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Text="{DynamicResource S.Settings.LookGroup}" Style="{StaticResource Gruppe}" Margin="0,0,0,2" />

    <StackPanel Orientation="Horizontal">
      <StackPanel Width="200">
        <Label Content="{DynamicResource S.Settings.Language}" />
        <ComboBox x:Name="LanguageBox" SelectionChanged="OnLookChanged">
          <ComboBoxItem Content="{DynamicResource S.Settings.System}" />
          <ComboBoxItem Content="Deutsch" />
          <ComboBoxItem Content="English" />
        </ComboBox>
      </StackPanel>
      <StackPanel Width="200" Margin="16,0,0,0">
        <Label Content="{DynamicResource S.Settings.Theme}" />
        <ComboBox x:Name="ThemeBox" SelectionChanged="OnLookChanged">
          <ComboBoxItem Content="{DynamicResource S.Settings.System}" />
          <ComboBoxItem Content="{DynamicResource S.Settings.Light}" />
          <ComboBoxItem Content="{DynamicResource S.Settings.Dark}" />
        </ComboBox>
      </StackPanel>
    </StackPanel>

    <TextBlock Text="{DynamicResource S.Device.StartGroup}" Style="{StaticResource Gruppe}" />

    <CheckBox x:Name="AutostartBox" Margin="0,4,0,0" Content="{DynamicResource S.Device.Autostart}" />
    <CheckBox x:Name="StartMinimizedBox" Margin="0,6,0,0" Content="{DynamicResource S.Device.StartMinimized}" />
    <CheckBox x:Name="CloseToTrayBox" Margin="0,6,0,0" Content="{DynamicResource S.Device.CloseToTray}" />

    <!-- Nachsehen heisst nachsehen: eine Abfrage, welche Freigabe auf GitHub
         die neueste ist. Geladen wird nichts, gemeldet wird nichts. -->
    <StackPanel Width="200" HorizontalAlignment="Left" Margin="0,12,0,0">
      <Label Content="{DynamicResource S.Settings.UpdateCheck}" />
      <ComboBox x:Name="UpdateBox">
        <ComboBoxItem Content="{DynamicResource S.Settings.UpdateNever}" />
        <ComboBoxItem Content="{DynamicResource S.Settings.UpdateWeekly}" />
        <ComboBoxItem Content="{DynamicResource S.Settings.UpdateMonthly}" />
      </ComboBox>
    </StackPanel>
    <TextBlock Style="{StaticResource Hinweis}" Text="{DynamicResource S.Settings.UpdateHint}" />
    <TextBlock Style="{StaticResource Hinweis}" Text="{DynamicResource S.Device.StartHint}" />

    <TextBlock Text="{DynamicResource S.Settings.StorageGroup}" Style="{StaticResource Gruppe}" />

    <StackPanel Width="200" HorizontalAlignment="Left" Margin="0,4,0,0">
      <Label Content="{DynamicResource S.Settings.Threshold}" />
      <TextBox x:Name="ThresholdBox" />
    </StackPanel>
    <TextBlock Style="{StaticResource Hinweis}" Text="{DynamicResource S.Settings.ThresholdHint}" />

    <TextBlock Text="{DynamicResource S.Settings.ThumbGroup}" Style="{StaticResource Kopfzeile}" Margin="0,16,0,0" />

    <CheckBox x:Name="ThumbsBox" Content="{DynamicResource S.Settings.Thumbs}" />
    <TextBlock Style="{StaticResource Hinweis}" Text="{DynamicResource S.Settings.ThumbsHint}" />

    <TextBlock x:Name="ThumbUsageText" Margin="0,10,0,0" TextWrapping="Wrap" />
    <Button x:Name="ClearButton" Content="{DynamicResource S.Settings.ClearThumbs}" Padding="10,3"
            HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnClearThumbnails" />

    <!-- Was das Programm in der Registrierung eintraegt, geschieht beim Start
         von selbst und kann lautlos scheitern. Hier steht, was tatsaechlich
         eingetragen ist, und hier laesst es sich wieder entfernen. -->
    <TextBlock Text="{DynamicResource S.Settings.ShellGroup}" Style="{StaticResource Gruppe}" />

    <TextBlock Style="{StaticResource Hinweis}" Text="{DynamicResource S.Settings.ShellHint}" />

    <!-- Zwei Spalten, Zeile fuer Zeile gegeneinander. Als fortlaufender Satz
         standen Name, Fassung, Datum und Pfad beider Dateien hintereinander
         in einem Absatz, und niemand konnte sie auseinanderhalten. -->
    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="120" />
        <ColumnDefinition Width="*" MinWidth="120" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="1" Margin="10,0,10,4" FontWeight="SemiBold"
                 Text="{DynamicResource S.Settings.ShellShipped}" />
      <TextBlock Grid.Row="0" Grid.Column="2" Margin="10,0,0,4" FontWeight="SemiBold"
                 Text="{DynamicResource S.Settings.ShellRegistered}" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource S.Settings.ShellFile}"
                 Foreground="{DynamicResource Gedaempft}" />
      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ShipName" Margin="10,0,10,0" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Row="1" Grid.Column="2" x:Name="RegName" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource S.Settings.ShellVersion}"
                 Foreground="{DynamicResource Gedaempft}" />
      <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ShipVersion" Margin="10,0,10,0" />
      <TextBlock Grid.Row="2" Grid.Column="2" x:Name="RegVersion" Margin="10,0,0,0" />

      <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource S.Settings.ShellChanged}"
                 Foreground="{DynamicResource Gedaempft}" />
      <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ShipChanged" Margin="10,0,10,0" />
      <TextBlock Grid.Row="3" Grid.Column="2" x:Name="RegChanged" Margin="10,0,0,0" />

      <!-- Der Ordner ist lang und selten wichtig. Abgeschnitten, mit dem
           ganzen Pfad beim Ueberfahren. -->
      <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource S.Settings.ShellFolder}"
                 Foreground="{DynamicResource Gedaempft}" />
      <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ShipFolder" Margin="10,0,10,0"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <TextBlock Grid.Row="4" Grid.Column="2" x:Name="RegFolder" Margin="10,0,0,0"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Grid>

    <TextBlock x:Name="ShellStateText" Margin="0,10,0,0" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
      <Button x:Name="ShellRegisterButton" Content="{DynamicResource S.Settings.ShellRegister}"
              Padding="10,3" Click="OnRegisterShell" />
      <Button x:Name="ShellUnregisterButton" Content="{DynamicResource S.Settings.ShellUnregister}"
              Padding="10,3" Margin="8,0,0,0" Click="OnUnregisterShell" />    </StackPanel>

    <TextBlock Text="{DynamicResource S.Settings.DataGroup}" Style="{StaticResource Gruppe}" />

    <Label Content="{DynamicResource S.Settings.DataDir}" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Browse}" Padding="10,3"
              Margin="6,0,0,0" Click="OnBrowseHome" />
      <TextBox x:Name="HomeBox" VerticalContentAlignment="Center" />
    </DockPanel>
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.DataDirHint}" />

    <TextBlock Text="{DynamicResource S.Settings.NetGroup}" Style="{StaticResource Gruppe}" />

    <CheckBox x:Name="ListenBox" Content="{DynamicResource S.Settings.Listen}" Margin="0,4,0,0" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.ListenHint}" />

    <StackPanel Orientation="Horizontal">
      <StackPanel Width="240">
        <Label Content="{DynamicResource S.Settings.ListenPort}" />
        <TextBox x:Name="ListenPortBox" />
      </StackPanel>
      <StackPanel Width="200" Margin="16,0,0,0">
        <Label Content="{DynamicResource S.Settings.Parallelism}" />
        <TextBox x:Name="ParallelismBox" />
      </StackPanel>
    </StackPanel>

    <CheckBox x:Name="LocalDiscoveryBox" Margin="0,12,0,0"
              Content="{DynamicResource S.Settings.LocalDiscovery}" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.LocalDiscoveryHint}" />

    <CheckBox x:Name="AnnounceBox" Margin="0,12,0,0"
              Content="{DynamicResource S.Settings.Announce}" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.AnnounceHint}" />

    <CheckBox x:Name="DiscoveryBox" Margin="0,12,0,0"
              Content="{DynamicResource S.Settings.Lookup}" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.LookupHint}" />

    <Label Content="{DynamicResource S.Settings.Servers}" Margin="0,6,0,0" />
    <TextBox x:Name="DiscoveryServerBox" Height="66" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.ServersHint}" />

    <CheckBox x:Name="RelaysBox" Margin="0,12,0,0"
              Content="{DynamicResource S.Settings.Relays}" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.RelaysHint}" />

    <DockPanel Margin="0,18,0,0">
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Save}" Padding="14,4" Click="OnSave" Margin="0" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Cancel}" Padding="14,4" IsCancel="True" Margin="0,0,6,0" />
      <TextBlock x:Name="Hint" Foreground="{DynamicResource Gedaempft}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
  </StackPanel>
  </ScrollViewer>
</Window>
