<Window x:Class="SyncTClient.Gui.ProgramSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Settings.Title}" Height="640" Width="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource Flaeche}">
  <Window.Resources>
    <Style x:Key="Gruppe" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Gedaempft}" />
      <Setter Property="Margin" Value="0,14,0,2" />
    </Style>
    <Style x:Key="Hinweis" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Gedaempft}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="16">

    <TextBlock Text="{DynamicResource S.Settings.LookGroup}" Style="{StaticResource Gruppe}" Margin="0,0,0,2" />

    <StackPanel Orientation="Horizontal">
      <StackPanel Width="200">
        <Label Content="{DynamicResource S.Settings.Language}" />
        <ComboBox x:Name="LanguageBox" SelectionChanged="OnLookChanged">
          <ComboBoxItem Content="{DynamicResource S.Settings.System}" />
          <ComboBoxItem Content="Deutsch" />
          <ComboBoxItem Content="English" />
        </ComboBox>
      </StackPanel>
      <StackPanel Width="200" Margin="16,0,0,0">
        <Label Content="{DynamicResource S.Settings.Theme}" />
        <ComboBox x:Name="ThemeBox" SelectionChanged="OnLookChanged">
          <ComboBoxItem Content="{DynamicResource S.Settings.System}" />
          <ComboBoxItem Content="{DynamicResource S.Settings.Light}" />
          <ComboBoxItem Content="{DynamicResource S.Settings.Dark}" />
        </ComboBox>
      </StackPanel>
    </StackPanel>

    <TextBlock Text="{DynamicResource S.Main.Cache}" Style="{StaticResource Gruppe}" />

    <Label Content="{DynamicResource S.Settings.CacheDir}" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Browse}" Padding="10,3"
              Margin="6,0,0,0" Click="OnBrowseShares" />
      <TextBox x:Name="SharesRootBox" VerticalContentAlignment="Center" TextChanged="OnSharesRootChanged" />
    </DockPanel>
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.CacheDirHint}" />

    <TextBlock x:Name="FreeSpaceText" Style="{StaticResource Hinweis}" Margin="0,6,0,0" />

    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
      <StackPanel Width="200">
        <Label Content="{DynamicResource S.Settings.Budget}" />
        <TextBox x:Name="CacheBudgetBox" />
      </StackPanel>
      <StackPanel Width="240" Margin="16,0,0,0">
        <Label Content="{DynamicResource S.Settings.MinFree}" />
        <TextBox x:Name="MinimumFreeBox" />
      </StackPanel>
    </StackPanel>
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.LimitsHint}" />

    <TextBlock x:Name="UsageText" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />

    <Button x:Name="ClearButton" Content="{DynamicResource S.Settings.ClearCache}" Padding="10,3"
            HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnClearCache" />

    <TextBlock Text="{DynamicResource S.Settings.DataGroup}" Style="{StaticResource Gruppe}" />

    <Label Content="{DynamicResource S.Settings.DataDir}" />
    <DockPanel>
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Browse}" Padding="10,3"
              Margin="6,0,0,0" Click="OnBrowseHome" />
      <TextBox x:Name="HomeBox" VerticalContentAlignment="Center" />
    </DockPanel>
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.DataDirHint}" />

    <TextBlock Text="{DynamicResource S.Settings.NetGroup}" Style="{StaticResource Gruppe}" />

    <CheckBox x:Name="ListenBox" Content="{DynamicResource S.Settings.Listen}" Margin="0,4,0,0" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.ListenHint}" />

    <StackPanel Orientation="Horizontal">
      <StackPanel Width="240">
        <Label Content="{DynamicResource S.Settings.ListenPort}" />
        <TextBox x:Name="ListenPortBox" />
      </StackPanel>
      <StackPanel Width="200" Margin="16,0,0,0">
        <Label Content="{DynamicResource S.Settings.Parallelism}" />
        <TextBox x:Name="ParallelismBox" />
      </StackPanel>
    </StackPanel>

    <CheckBox x:Name="LocalDiscoveryBox" Margin="0,12,0,0"
              Content="{DynamicResource S.Settings.LocalDiscovery}" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.LocalDiscoveryHint}" />

    <CheckBox x:Name="AnnounceBox" Margin="0,12,0,0"
              Content="{DynamicResource S.Settings.Announce}" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.AnnounceHint}" />

    <CheckBox x:Name="DiscoveryBox" Margin="0,12,0,0"
              Content="{DynamicResource S.Settings.Lookup}" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.LookupHint}" />

    <Label Content="{DynamicResource S.Settings.Servers}" Margin="0,6,0,0" />
    <TextBox x:Name="DiscoveryServerBox" Height="66" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.ServersHint}" />

    <CheckBox x:Name="RelaysBox" Margin="0,12,0,0"
              Content="{DynamicResource S.Settings.Relays}" />
    <TextBlock Style="{StaticResource Hinweis}"
               Text="{DynamicResource S.Settings.RelaysHint}" />

    <DockPanel Margin="0,18,0,0">
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Save}" Padding="14,4" Click="OnSave" Margin="0" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Cancel}" Padding="14,4" IsCancel="True" Margin="0,0,6,0" />
      <TextBlock x:Name="Hint" Foreground="{DynamicResource Gedaempft}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>
  </StackPanel>
  </ScrollViewer>
</Window>
