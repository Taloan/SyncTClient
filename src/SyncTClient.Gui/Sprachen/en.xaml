  <s:String x:Key="S.New.ModeOnDemand">on demand</s:String>
  <s:String x:Key="S.New.ModeAlwaysLocal">always local</s:String>
  <s:String x:Key="S.New.ModeHint">The folder is already here. “always local” keeps it that way; “on demand” frees space later, once the remote holds the files.</s:String>
