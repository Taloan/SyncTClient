<Window x:Class="SyncTClient.Gui.PeerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server hinzufügen"
        Height="330" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <StackPanel Margin="16">
    <Label Content="Name (frei wählbar)" />
    <TextBox x:Name="NameBox" />

    <Label Content="Adresse" />
    <TextBox x:Name="AddressBox" />
    <TextBlock Foreground="Gray" FontSize="11" Margin="0,0,0,8"
               Text="Host und Port, etwa 192.168.1.42:22000. Ohne Port wird 22000 angenommen." />

    <Label Content="Device-ID der Gegenstelle" />
    <TextBox x:Name="DeviceIdBox" FontFamily="Consolas" />
    <TextBlock x:Name="Hint" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="In der Syncthing-Oberfläche der Gegenstelle unter „Dieses Gerät → Kennung“." />

    <CheckBox x:Name="AutoBox" Content="Beim Start automatisch verbinden" IsChecked="True" Margin="0,4,0,12" />

    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Abbrechen" IsCancel="True" Margin="0" />
      <Button DockPanel.Dock="Right" Content="Hinzufügen" Click="OnAdd" IsDefault="True" />
      <TextBlock />
    </DockPanel>
  </StackPanel>
</Window>
