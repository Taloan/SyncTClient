<Window x:Class="SyncTClient.Gui.SharePeersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Nodes.Node}" Height="320" Width="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Flaeche}">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
      <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource Gedaempft}" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <Button DockPanel.Dock="Bottom" Content="{DynamicResource S.Close}" Padding="12,4" IsCancel="True"
            HorizontalAlignment="Right" Margin="0,10,0,0" />

    <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource RahmenFein}"
              BorderBrush="{DynamicResource Rahmen}" BorderThickness="1" RowHeight="28">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{DynamicResource S.Nodes.Activity}" Width="190" Binding="{Binding Activity}" />
        <DataGridTextColumn Header="{DynamicResource S.Nodes.Node}" Width="170" Binding="{Binding Name}" />
        <DataGridTextColumn Header="{DynamicResource S.Peer.Address}" Width="160" Binding="{Binding Address}" />
        <DataGridTextColumn Header="{DynamicResource S.Nodes.Open}" Width="*" Binding="{Binding Outstanding}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
