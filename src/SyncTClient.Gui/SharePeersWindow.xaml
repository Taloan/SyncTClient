<Window x:Class="SyncTClient.Gui.SharePeersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Nodes.Node}"
        SizeToContent="WidthAndHeight" MinWidth="560" MinHeight="260" MaxWidth="1400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Flaeche}">
  <!-- Das Fenster richtet sich nach seinem Inhalt und nicht nach einer
       einmal geschaetzten Zahl. Eine feste Breite passt genau so lange, bis
       eine Adresse laenger wird oder eine Uebersetzung mehr Platz braucht;
       danach steht die letzte Spalte halb ausserhalb.

       Eine Untergrenze bleibt, damit ein Fenster mit einer einzigen kurzen
       Zeile nicht zum Zettel schrumpft, und eine Obergrenze, damit eine
       lange Adresse es nicht ueber den Bildschirm hinauszieht. -->
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
      <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource Gedaempft}" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <Button DockPanel.Dock="Bottom" Content="{DynamicResource S.Close}" Padding="12,4" IsCancel="True"
            HorizontalAlignment="Right" Margin="0,10,0,0" />

    <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource RahmenFein}"
              BorderBrush="{DynamicResource Rahmen}" BorderThickness="1" RowHeight="28"
              MinHeight="120">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{DynamicResource S.Nodes.Activity}" Width="Auto" MinWidth="120"
                            Binding="{Binding Activity}" />
        <DataGridTextColumn Header="{DynamicResource S.Nodes.Node}" Width="Auto" MinWidth="110"
                            Binding="{Binding Name}" />
        <DataGridTextColumn Header="{DynamicResource S.Peer.Address}" Width="Auto" MinWidth="140"
                            Binding="{Binding Address}" />
        <!-- Anklickbar, sobald etwas aussteht. Die Zahl sagt, dass etwas
             offen ist; welche Dateien es sind, steht dahinter. -->
        <DataGridTemplateColumn Header="{DynamicResource S.Nodes.Open}" Width="Auto" MinWidth="150"
                                SortMemberPath="Outstanding">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding Outstanding}" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>

                <TextBlock VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                  <Hyperlink Click="OnShowOutstanding" ToolTip="{DynamicResource S.Open.Hint}">
                    <Run Text="{Binding Outstanding, Mode=OneWay}" />
                  </Hyperlink>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
