<Window x:Class="SyncTClient.Gui.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SyncTClient" Width="360" MaxHeight="620" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Flaeche}">
  <!-- Der Blick aus dem Infobereich: was gerade laeuft, ohne das ganze
       Fenster zu oeffnen. Es ist dieselbe Zeilenliste wie in der Uebersicht,
       nur schmal: die Daten werden nicht ein zweites Mal beschafft, sondern
       ein zweites Mal gezeigt. -->
  <Border BorderBrush="{DynamicResource Rahmen}" BorderThickness="1">
    <DockPanel>

      <!-- Kopf: Zustand in einem Satz, dazu die beiden Wege weiter. -->
      <Grid DockPanel.Dock="Top" Margin="14,12,10,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="SyncTClient" FontSize="14" FontWeight="SemiBold" />
          <TextBlock x:Name="StateText" Foreground="{DynamicResource Gedaempft}" FontSize="11"
                     TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Click="OnSettings" Width="28" Height="28" Padding="0" Focusable="False"
                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                  ToolTip="{DynamicResource S.Main.Settings}">
            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{DynamicResource Sekundaer}" />
          </Button>
          <Button Click="OnOpenWindow" Width="28" Height="28" Padding="0" Focusable="False"
                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                  ToolTip="{DynamicResource S.Tray.Open}">
            <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{DynamicResource Sekundaer}" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Fuss: die Handlung, die man von hier aus am ehesten will. -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource RahmenFein}" BorderThickness="0,1,0,0"
              Padding="10,8">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="PauseButton" Click="OnTogglePause" Padding="10,3" Margin="0,0,6,0" />
          <Button Content="{DynamicResource S.Tray.Open}" Click="OnOpenWindow" Padding="10,3" />
        </StackPanel>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,12">

          <!-- Eine Zeile je Freigabe. Balken nur, wenn etwas aussteht: einer,
               der auf hundert steht, sagt nichts. -->
          <ItemsControl x:Name="ShareList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,10">
                  <DockPanel>
                    <TextBlock Text="{Binding StatusText}" DockPanel.Dock="Right" FontSize="11"
                               Foreground="{DynamicResource Gedaempft}" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>

                  <Grid Margin="0,4,0,0">
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Busy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>

                    <ProgressBar Height="14" Minimum="0" Maximum="100"
                                 Value="{Binding Percent, Mode=OneWay}"
                                 IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                 Template="{StaticResource BalkenVorlage}" Background="{DynamicResource Feld}" Foreground="{DynamicResource Ein}" />
                    <TextBlock Text="{Binding ProgressText}" FontSize="10" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock.Effect>
                        <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="5" Opacity="1" />
                      </TextBlock.Effect>
                    </TextBlock>
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="TransferHeader" Text="{DynamicResource S.Status.Recent}"
                     FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Gedaempft}"
                     Margin="0,4,0,6" />

          <!-- Zuletzt geholte Dateien, wie im Infobereich von OneDrive. Sie
               beantworten die Frage, die man beim Klick auf das Symbol
               tatsaechlich hat: passiert gerade etwas, und was. -->
          <ItemsControl x:Name="TransferList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,6">
                  <TextBlock Text="{Binding StateText}" DockPanel.Dock="Right" FontSize="10"
                             Foreground="{DynamicResource Gedaempft}" VerticalAlignment="Center"
                             Margin="8,0,0,0" />
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="11" />
                    <TextBlock Text="{Binding Progress}" FontSize="10"
                               Foreground="{DynamicResource Gedaempft}" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="QuietText" Text="{DynamicResource S.Status.Quiet}" FontSize="11"
                     Foreground="{DynamicResource Gedaempft}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
