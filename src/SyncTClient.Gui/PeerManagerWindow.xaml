<Window x:Class="SyncTClient.Gui.PeerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Peers.Title}" Height="440" Width="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Flaeche}">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Gedaempft}" TextWrapping="Wrap" Margin="0,0,0,10"
               Text="{DynamicResource S.Peers.Hint}" />

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Close}" Padding="12,4" IsCancel="True" Margin="0" />
      <WrapPanel>
        <Button Content="{DynamicResource S.Add}" Padding="10,4" Margin="0,0,6,0" Click="OnAdd" />
        <Button x:Name="EditButton" Content="{DynamicResource S.Edit}" Padding="10,4" Margin="0,0,6,0" Click="OnEdit" />
        <Button x:Name="ConnectButton" Content="{DynamicResource S.Peers.Connect}" Padding="10,4" Margin="0,0,6,0" Click="OnConnect" />
        <Button Content="{DynamicResource S.Remove}" Padding="10,4" Click="OnRemove" />
      </WrapPanel>
    </DockPanel>

    <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource RahmenFein}"
              BorderBrush="{DynamicResource Rahmen}" BorderThickness="1" RowHeight="28"
              SelectionChanged="OnSelected">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{DynamicResource S.Col.Name}" Width="200" Binding="{Binding Display}" />
        <DataGridTextColumn Header="{DynamicResource S.Peers.State}" Width="150" Binding="{Binding StateText}" />
        <DataGridTextColumn Header="{DynamicResource S.Peers.Address}" Width="*" Binding="{Binding Detail}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
