<Window x:Class="SyncTClient.Gui.PeerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gegenstellen" Height="440" Width="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"
               Text="Syncthing verlangt, dass sich beide Seiten kennen. Eine Gegenstelle muss diesem Gerät die Ordner ausdrücklich freigeben — erst dann erscheinen sie in der Übersicht und lassen sich übernehmen." />

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Schließen" Padding="12,4" IsCancel="True" Margin="0" />
      <WrapPanel>
        <Button Content="Hinzufügen" Padding="10,4" Margin="0,0,6,0" Click="OnAdd" />
        <Button x:Name="ConnectButton" Content="Verbinden" Padding="10,4" Margin="0,0,6,0" Click="OnConnect" />
        <Button Content="Entfernen" Padding="10,4" Click="OnRemove" />
      </WrapPanel>
    </DockPanel>

    <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
              BorderBrush="#DDD" BorderThickness="1" RowHeight="28"
              SelectionChanged="OnSelected">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Width="200" Binding="{Binding Display}" />
        <DataGridTextColumn Header="Zustand" Width="150" Binding="{Binding StateText}" />
        <DataGridTextColumn Header="Adresse und Fassung" Width="*" Binding="{Binding Detail}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
