<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Flächen -->
  <SolidColorBrush x:Key="Flaeche" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Leiste" Color="#FAFAFA" />
  <SolidColorBrush x:Key="Feld" Color="#FFFFFF" />

  <!-- Linien -->
  <SolidColorBrush x:Key="Rahmen" Color="#DDDDDD" />
  <SolidColorBrush x:Key="RahmenFein" Color="#EEEEEE" />
  <SolidColorBrush x:Key="Trenner" Color="#CCCCCC" />

  <!-- Schrift -->
  <SolidColorBrush x:Key="Text" Color="#111111" />
  <SolidColorBrush x:Key="Sekundaer" Color="#555555" />
  <SolidColorBrush x:Key="Gedaempft" Color="#888888" />
  <SolidColorBrush x:Key="Symbol" Color="#B0B0B0" />

  <!-- Bedeutungen -->
  <SolidColorBrush x:Key="Ein" Color="#1E88E5" />
  <SolidColorBrush x:Key="Aus" Color="#43A047" />
  <SolidColorBrush x:Key="Gut" Color="#2E9E4F" />
  <SolidColorBrush x:Key="Warnung" Color="#C77700" />

  <!-- Auswahl: hell genug, dass die eigenen Farben der Zellen lesbar bleiben -->
  <SolidColorBrush x:Key="AuswahlFlaeche" Color="#CFE4F7" />
  <SolidColorBrush x:Key="AuswahlFlaecheRuhig" Color="#E6EEF6" />
  <SolidColorBrush x:Key="AuswahlText" Color="#111111" />

  <!-- Was Windows selbst faerbt: der Auswahlbalken in Gittern und Listen.
       Ohne diese Ueberschreibung bliebe er das kraeftige Systemblau, auf dem
       die eigenen Farben der Zellen nicht mehr zu lesen waeren. -->
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CFE4F7" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#111111" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E6EEF6" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#111111" />

</ResourceDictionary>

