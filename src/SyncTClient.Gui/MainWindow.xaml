<Window x:Class="SyncTClient.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SyncTClient.Gui"
        Title="SyncTClient"
        Height="820" Width="1280" MinWidth="1000" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded" Closing="OnClosing"
        Background="{DynamicResource Flaeche}">

  <Window.Resources>
    <Style x:Key="Kopfzeile" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Gedaempft}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Kennzahl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="Beschriftung" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Gedaempft}" />
    </Style>

    <!-- Merkmal und Wert der aufgeklappten Zeile. Das Merkmal tritt zurueck,
         damit beim Ueberfliegen die Zahlen stehenbleiben und nicht ihre
         Benennungen. -->
    <Style x:Key="Merkmal" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Gedaempft}" />
      <Setter Property="Margin" Value="0,0,14,4" />
    </Style>
    <Style x:Key="Wert" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <BooleanToVisibilityConverter x:Key="Sichtbar" />

    <!-- Der Inhalt einer Textspalte. VerticalContentAlignment an der Zelle
         reicht nicht: DataGridTextColumn setzt dem TextBlock eine eigene
         Vorlage auf, und die gewinnt. Die Ausrichtung muss also dort stehen,
         wo der TextBlock entsteht. -->
    <!-- Das Netzzeichen. Es steht in der Knotenspalte und vor den beiden
         Spalten, die den Stand im Netz nennen; die beiden lokalen tragen
         daneben ihr Datentraegerzeichen. Ohne diese Unterscheidung heissen
         vier Spalten "Dateien" und "Groesse", und keine sagt, wovon. -->
    <ControlTemplate x:Key="Netzzeichen">
      <Canvas Width="18" Height="16" Background="Transparent">
        <Line X1="4" Y1="5" X2="13" Y2="5" Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
        <Line X1="4" Y1="5" X2="8.5" Y2="12" Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
        <Line X1="13" Y1="5" X2="8.5" Y2="12" Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
        <Ellipse Canvas.Left="1.5" Canvas.Top="2.5" Width="5" Height="5" Fill="{DynamicResource Sekundaer}" />
        <Ellipse Canvas.Left="10.5" Canvas.Top="2.5" Width="5" Height="5" Fill="{DynamicResource Sekundaer}" />
        <Ellipse Canvas.Left="6" Canvas.Top="9.5" Width="5" Height="5" Fill="{DynamicResource Sekundaer}" />
      </Canvas>
    </ControlTemplate>

    <!-- Eine Uebertragung ist eine Zeile hoch. Alles steht auf dem Balken:
         Name links, Menge und Zustand rechts. Drei Zeilen je Datei waren bei
         zwanzig gleichzeitigen Uebertragungen eine Bildschirmseite pro
         Handvoll.

         Der Text steht weiss mit dunklem Saum, damit er auf der Fuellung wie
         auf dem Rest lesbar bleibt: dasselbe Verfahren wie bei Untertiteln
         in einem Film, aus demselben Grund. -->
    <DataTemplate x:Key="Uebertragung">
      <Grid Margin="0,2" Height="24" ToolTip="{Binding RelativePath}">
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />

        <DockPanel Margin="6,0">
          <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="11"
                     Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White"
                     FontWeight="SemiBold">
            <TextBlock.Effect>
              <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="5" Opacity="1" />
            </TextBlock.Effect>
          </TextBlock>

          <TextBlock DockPanel.Dock="Right" Text="{Binding Progress}" FontSize="11"
                     Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White"
                     FontWeight="SemiBold">
            <TextBlock.Effect>
              <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="5" Opacity="1" />
            </TextBlock.Effect>
          </TextBlock>

          <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold">
            <TextBlock.Effect>
              <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="5" Opacity="1" />
            </TextBlock.Effect>
          </TextBlock>
        </DockPanel>
      </Grid>
    </DataTemplate>

    <Style x:Key="ZelleMitte" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="120" />
      <RowDefinition Height="Auto" />
      <RowDefinition x:Name="BottomRow" Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===================== Werkzeugleiste ===================== -->
    <DockPanel Grid.Row="0" Margin="10,8,10,8">
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Main.Device}" Click="OnShowDevice" Margin="0" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Main.Peers}" Click="OnManagePeers" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Main.Settings}" Click="OnShowProgramSettings" />
      <Button x:Name="PauseAllButton" DockPanel.Dock="Left"
              Content="{DynamicResource S.Main.PauseAll}" Click="OnTogglePauseAll" />
      <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Gedaempft}"
                 Text="{DynamicResource S.Main.MenuHint}" />
    </DockPanel>

    <!-- ===================== Freigaben ===================== -->
    <DataGrid x:Name="ShareGrid" Grid.Row="1" Margin="10,0,10,0"
              AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
              SelectionMode="Single" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource RahmenFein}"
              BorderBrush="{DynamicResource Rahmen}" BorderThickness="1" RowHeight="30"
              SelectionChanged="OnShareSelected" MouseDoubleClick="OnGridDoubleClick"
              PreviewMouseRightButtonDown="OnGridRightClick"
              RowDetailsVisibilityMode="Visible">

      <!-- Die Textspalten setzen ihren Inhalt sonst an den oberen Rand.
           Solange die Zeile so hoch war wie ihr Text, fiel das nicht auf;
           seit die uebrigen Spalten hoehere Inhalte tragen, stehen die Zahlen
           sichtbar zu hoch. Gesetzt wird es einmal fuer alle Zellen und nicht
           je Spalte, denn eine Ausrichtung, die man je Spalte wiederholen
           muss, wird irgendwo vergessen. -->
      <!-- Die Ueberschrift steht ueber ihrer Spalte und nicht am linken Rand
           davon. Bei einer Spalte, die 95 Punkte breit ist und eine kurze
           Zahl traegt, laeuft die Beschriftung sonst von der Zahl weg. -->
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
          <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
      </DataGrid.ColumnHeaderStyle>

      <DataGrid.CellStyle>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
      </DataGrid.CellStyle>

      <!-- Aufgeklappt steht in der Zeile, was in keine Spalte passt. Nicht
           alles davon gehoert nebeneinander: die Zahlen sind ein Vergleich
           und werden untereinander gelesen. Sichtbar wird es an der
           ausgewaehlten Zeile, denn mehrere gleichzeitig aufgeklappt waeren
           dieselbe Unuebersichtlichkeit, die die Spalten schon haben. -->
      <DataGrid.RowDetailsTemplate>
        <DataTemplate>
          <!-- Die Detailzeile ist immer da, ihr Inhalt nicht. Ueber
               DetailsVisibility der Zeile ginge es nicht: das DataGrid setzt
               diesen Wert aus RowDetailsVisibilityMode selbst und ueberschreibt
               damit jede Bindung. Ein eingeklappter Rahmen belegt keinen
               Platz, und die Zeile sieht aus wie vorher. -->
          <Border Background="{DynamicResource Feld}" BorderBrush="{DynamicResource RahmenFein}"
                  BorderThickness="0,1,0,1" Padding="16,10"
                  Visibility="{Binding Expanded, Converter={StaticResource Sichtbar}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Detail.Global}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Wert}"
                         Text="{Binding GlobalText}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Detail.Local}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Wert}"
                         Text="{Binding LocalText}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Detail.Outstanding}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Wert}"
                         Text="{Binding OutstandingText}" />
              <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Detail.Awaiting}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Wert}"
                         Text="{Binding AwaitingText}"
                         ToolTip="{DynamicResource S.Detail.AwaitingHint}" />

              <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Detail.Content}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Wert}"
                         Text="{Binding ContentText}" />
              <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Detail.Thumbs}" />
              <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Wert}"
                         Text="{Binding ThumbDetailText}" />
              <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Detail.Transfer}" />
              <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Wert}">
                <Run Text="&#x2193; " Foreground="{DynamicResource Gedaempft}" /><Run Text="{Binding ReceivedText, Mode=OneWay}" /><Run Text="   &#x2191; " Foreground="{DynamicResource Gedaempft}" /><Run Text="{Binding SentText, Mode=OneWay}" />
              </TextBlock>

              <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Detail.FolderId}" />
              <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource Wert}"
                         Text="{Binding FolderIdText}" />
              <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Detail.Path}" />
              <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource Wert}"
                         Text="{Binding PathText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Detail.Mode}" />
              <TextBlock Grid.Row="2" Grid.Column="4" Style="{StaticResource Wert}"
                         Text="{Binding ModeText}" />
              <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Detail.Peers}" />
              <TextBlock Grid.Row="3" Grid.Column="4" Style="{StaticResource Wert}"
                         Text="{Binding PeersText}" />
              <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Detail.LastScan}" />
              <TextBlock Grid.Row="4" Grid.Column="4" Style="{StaticResource Wert}"
                         Text="{Binding LastScanText}" />
            </Grid>
          </Border>
        </DataTemplate>
      </DataGrid.RowDetailsTemplate>

      <DataGrid.Columns>

        <!-- Eigene Spalte, weil in der Namensspalte ein Klick das Umbenennen
             oeffnet. Ein Knopf, der etwas anderes tut als der Platz, auf dem
             er liegt, gewinnt diesen Streit nicht. -->
        <DataGridTemplateColumn Width="26" CanUserSort="False" CanUserResize="False"
                                CanUserReorder="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Click="OnToggleDetails" Width="20" Height="20" Padding="0"
                      Background="Transparent" BorderThickness="0" Focusable="False"
                      Cursor="Hand" ToolTip="{DynamicResource S.Col.Details}">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10"
                           Foreground="{DynamicResource Gedaempft}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="&#xE76C;" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Expanded}" Value="True">
                          <Setter Property="Text" Value="&#xE70D;" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Button>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn x:Name="ColName" Header="{DynamicResource S.Col.Name}" Width="240"
                                SortMemberPath="Name" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="{DynamicResource Symbol}" Margin="4,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>

          <!-- Umbenennen wie im Explorer: Klick, Pause, Klick. Ein
               Doppelklick oeffnet weiterhin den Ordner. -->
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <TextBox x:Name="NameEditor" Margin="2,0"
                       Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                       Loaded="OnNameEditorLoaded" />
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{DynamicResource S.Col.Status}" Width="190" SortMemberPath="StatusText" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{DynamicResource Gut}" VerticalAlignment="Center" Margin="0,0,6,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Ready}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{DynamicResource Sekundaer}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn x:Name="ColPeers" Width="60"
                                SortMemberPath="PeersText" CanUserSort="True">
          <!-- Gezeichnet statt beschriftet: die Spalte traegt eine Ziffer,
               eine Ueberschrift aus zwei Woertern waere breiter als ihr
               Inhalt. Der Name steht im Tooltip. -->
          <DataGridTemplateColumn.Header>
            <Control Template="{StaticResource Netzzeichen}" Width="18" Height="16"
                     ToolTip="{DynamicResource S.Col.Nodes}" />
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0">
                <Hyperlink Click="OnShowPeers" ToolTip="{DynamicResource S.Main.NodesTip}">
                  <Run Text="{Binding PeersText, Mode=OneWay}" />
                </Hyperlink>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn x:Name="ColProgress" Header="{DynamicResource S.Col.Progress}" Width="200"
                                SortMemberPath="Percent" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <!-- Der Text liegt auf dem Balken. Damit er auf der Fuellung
                   wie auf dem Rest lesbar bleibt, steht er weiss mit einem
                   dunklen Saum: eine feste Schriftfarbe allein waere immer
                   nur auf einer der beiden Haelften richtig. Dasselbe
                   Verfahren wie bei Untertiteln in einem Film, aus dem
                   gleichen Grund. -->
              <Grid VerticalAlignment="Center" Margin="4,0">
                <ProgressBar Height="15" Minimum="0" Maximum="100"
                             Value="{Binding Percent, Mode=OneWay}"
                             IsIndeterminate="{Binding Indeterminate, Mode=OneWay}">
                  <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Busy}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ProgressBar.Style>
                </ProgressBar>

                <TextBlock Text="{Binding ProgressText}" FontSize="10"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Sekundaer}" />
                      <Style.Triggers>
                        <!-- Nur wo ein Balken liegt, braucht es den Saum. Ohne
                             ihn traegt die Zeile die Farbe. -->
                        <DataTrigger Binding="{Binding Busy}" Value="True">
                          <Setter Property="Foreground" Value="White" />
                          <Setter Property="FontWeight" Value="SemiBold" />
                          <Setter Property="Effect">
                            <Setter.Value>
                              <DropShadowEffect Color="Black" ShadowDepth="0"
                                                BlurRadius="5" Opacity="1" />
                            </Setter.Value>
                          </Setter>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn x:Name="ColCopies" Width="60"
                                SortMemberPath="Copies" CanUserSort="True">
          <!-- Eine Wolke: wie viele Knoten den Inhalt liefern koennen. -->
          <DataGridTemplateColumn.Header>
            <Path Width="18" Height="14" Stretch="Uniform"
                  Fill="{DynamicResource Sekundaer}"
                  ToolTip="{DynamicResource S.Col.Copies}"
                  Data="M4.4,12.6 C2.5,12.6 1,11.1 1,9.3 C1,7.7 2.2,6.3 3.7,6.1
                        C4.1,4.1 5.9,2.6 8,2.6 C10.2,2.6 12,4.2 12.3,6.3
                        C13.9,6.6 15,7.9 15,9.5 C15,11.2 13.6,12.6 11.9,12.6 Z" />
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                          HorizontalAlignment="Center" Margin="4,0"
                          ToolTip="{Binding CopiesHint}">
                <TextBlock Text="{Binding CopiesText}" VerticalAlignment="Center" />
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{DynamicResource Warnung}" Margin="6,0,0,0" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding CopiesAtRisk}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Pfeil statt Wort: die Spalte traegt eine kurze Zahl, eine
             Ueberschrift aus einem ganzen Wort waere breiter als ihr Inhalt.
             Die Bedeutung steht im Tooltip und im Spaltenmenue. -->
        <DataGridTextColumn x:Name="ColReceived" ElementStyle="{StaticResource ZelleMitte}" Width="80"
                            Binding="{Binding ReceivedText}" SortMemberPath="ReceivedValue">
          <DataGridTextColumn.Header>
            <TextBlock Text="&#x2193;" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource Sekundaer}"
                       ToolTip="{DynamicResource S.Col.Received}" />
          </DataGridTextColumn.Header>
        </DataGridTextColumn>

        <DataGridTextColumn x:Name="ColSent" ElementStyle="{StaticResource ZelleMitte}" Width="80"
                            Binding="{Binding SentText}" SortMemberPath="SentValue">
          <DataGridTextColumn.Header>
            <TextBlock Text="&#x2191;" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource Sekundaer}"
                       ToolTip="{DynamicResource S.Col.Sent}" />
          </DataGridTextColumn.Header>
        </DataGridTextColumn>


        <DataGridTextColumn x:Name="ColSize" ElementStyle="{StaticResource ZelleMitte}" Width="95"
                            Binding="{Binding SizeText}" SortMemberPath="SizeValue">
          <DataGridTextColumn.Header>
            <StackPanel Orientation="Horizontal" Background="Transparent"
                        ToolTip="{DynamicResource S.Col.Size}">
              <Control Template="{StaticResource Netzzeichen}" Width="18" Height="16"
                       VerticalAlignment="Center" Margin="0,0,4,0" />
              <TextBlock Text="{DynamicResource S.Col.Size}" VerticalAlignment="Center" />
            </StackPanel>
          </DataGridTextColumn.Header>
        </DataGridTextColumn>

        <DataGridTextColumn x:Name="ColLocalFiles" ElementStyle="{StaticResource ZelleMitte}" Width="85"
                            Binding="{Binding LocalFilesText}" SortMemberPath="LocalFilesValue">
          <DataGridTextColumn.Header>
            <StackPanel Orientation="Horizontal" Background="Transparent"
                        ToolTip="{DynamicResource S.Col.LocalFiles}">
              <Canvas Width="16" Height="12" VerticalAlignment="Center" Margin="0,0,5,0">
                <Rectangle Canvas.Left="1" Canvas.Top="2" Width="14" Height="8" RadiusX="1.5" RadiusY="1.5"
                           Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
                <Line X1="1" Y1="7" X2="15" Y2="7" Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
                <Ellipse Canvas.Left="11" Canvas.Top="7.8" Width="2.4" Height="2.4"
                         Fill="{DynamicResource Sekundaer}" />
              </Canvas>
              <TextBlock Text="{DynamicResource S.Col.Files}" VerticalAlignment="Center" />
            </StackPanel>
          </DataGridTextColumn.Header>
        </DataGridTextColumn>

        <DataGridTextColumn x:Name="ColLocalSize" ElementStyle="{StaticResource ZelleMitte}" Width="95" Visibility="Collapsed"
                            Binding="{Binding LocalSizeText}" SortMemberPath="LocalSizeValue">
          <DataGridTextColumn.Header>
            <StackPanel Orientation="Horizontal" Background="Transparent"
                        ToolTip="{DynamicResource S.Col.LocalSize}">
              <Canvas Width="16" Height="12" VerticalAlignment="Center" Margin="0,0,5,0">
                <Rectangle Canvas.Left="1" Canvas.Top="2" Width="14" Height="8" RadiusX="1.5" RadiusY="1.5"
                           Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
                <Line X1="1" Y1="7" X2="15" Y2="7" Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
                <Ellipse Canvas.Left="11" Canvas.Top="7.8" Width="2.4" Height="2.4"
                         Fill="{DynamicResource Sekundaer}" />
              </Canvas>
              <TextBlock Text="{DynamicResource S.Col.Size}" VerticalAlignment="Center" />
            </StackPanel>
          </DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn x:Name="ColFiles" ElementStyle="{StaticResource ZelleMitte}" Width="90" Visibility="Collapsed"
                            Binding="{Binding FilesText}" SortMemberPath="FilesValue">
          <DataGridTextColumn.Header>
            <StackPanel Orientation="Horizontal" Background="Transparent"
                        ToolTip="{DynamicResource S.Col.Files}">
              <Control Template="{StaticResource Netzzeichen}" Width="18" Height="16"
                       VerticalAlignment="Center" Margin="0,0,4,0" />
              <TextBlock Text="{DynamicResource S.Col.Files}" VerticalAlignment="Center" />
            </StackPanel>
          </DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn x:Name="ColThumbs" ElementStyle="{StaticResource ZelleMitte}" Width="70" Visibility="Collapsed"
                            Binding="{Binding ThumbsText}" SortMemberPath="ThumbsValue">
          <!-- Ein Bild im Rahmen: Huegel und Sonne, wie jedes Bildsymbol seit
               dreissig Jahren. Der Name steht im Tooltip. -->
          <DataGridTextColumn.Header>
            <Canvas Width="18" Height="14" Background="Transparent"
                    ToolTip="{DynamicResource S.Col.Thumbs}">
              <Rectangle Canvas.Left="1" Canvas.Top="1" Width="16" Height="12" RadiusX="1.5" RadiusY="1.5"
                         Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
              <Ellipse Canvas.Left="4" Canvas.Top="3.4" Width="3" Height="3"
                       Fill="{DynamicResource Sekundaer}" />
              <Path Fill="{DynamicResource Sekundaer}"
                    Data="M2.2,12 L6.8,7.2 L9.6,10 L12.4,6.6 L15.8,12 Z" />
            </Canvas>
          </DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn x:Name="ColLimit" ElementStyle="{StaticResource ZelleMitte}" Width="85" Visibility="Collapsed"
                            Binding="{Binding LimitText}" SortMemberPath="LimitValue">
          <!-- Ein Fuellstand mit einer Marke davor: bis hierher und nicht
               weiter. Ein Fass oder eine Waage waere huebscher und sagte
               weniger. -->
          <DataGridTextColumn.Header>
            <Canvas Width="18" Height="14" Background="Transparent"
                    ToolTip="{DynamicResource S.Col.Limit}">
              <Rectangle Canvas.Left="1" Canvas.Top="4" Width="16" Height="7" RadiusX="1.5" RadiusY="1.5"
                         Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
              <Rectangle Canvas.Left="2.2" Canvas.Top="5.2" Width="7" Height="4.6"
                         Fill="{DynamicResource Sekundaer}" />
              <Line X1="12.5" Y1="2" X2="12.5" Y2="13" Stroke="{DynamicResource Warnung}"
                    StrokeThickness="1.6" />
            </Canvas>
          </DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn x:Name="ColMode" ElementStyle="{StaticResource ZelleMitte}" Header="{DynamicResource S.Col.Mode}" Width="130" Visibility="Collapsed"
                            Binding="{Binding ModeText}" />
        <DataGridTextColumn x:Name="ColLast" ElementStyle="{StaticResource ZelleMitte}" Width="110" Visibility="Collapsed"
                            Binding="{Binding LastTransferText}" SortMemberPath="LastTransferValue">
          <!-- Eine Uhr. Die Zeiger stehen auf zehn nach zehn, weil ein Zifferblatt
               so am ehesten als Uhr gelesen wird und nicht als Kreis mit Strichen. -->
          <DataGridTextColumn.Header>
            <Canvas Width="16" Height="16" Background="Transparent"
                    ToolTip="{DynamicResource S.Col.LastTransfer}">
              <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="13" Height="13"
                       Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
              <Line X1="8" Y1="8" X2="8" Y2="4.5" Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
              <Line X1="8" Y1="8" X2="10.8" Y2="9.6" Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
            </Canvas>
          </DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn x:Name="ColFolderId" ElementStyle="{StaticResource ZelleMitte}" Header="{DynamicResource S.Col.FolderId}" Width="120" Visibility="Collapsed"
                            Binding="{Binding FolderId}" />
        <DataGridTemplateColumn x:Name="ColPath" Header="{DynamicResource S.Col.Folder}" Width="*"
                                SortMemberPath="PathText" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0"
                         TextTrimming="CharacterEllipsis">
                <Hyperlink Click="OnOpenPath" ToolTip="{Binding PathText}">
                  <Run Text="{Binding PathText, Mode=OneWay}" />
                </Hyperlink>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter x:Name="Splitter" Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                  VerticalAlignment="Center" Background="Transparent" />

    <!-- ===================== Unterer Bereich ===================== -->
    <!-- Ein Bereich statt dreier untereinander. Die Höhe teilt sich der
         Bereich mit der Liste darüber; der Griff dazwischen verschiebt sie. -->
    <TabControl x:Name="BottomTabs" Grid.Row="3" Margin="10,0,10,0"
                BorderBrush="{DynamicResource Rahmen}">

      <TabItem Header="{DynamicResource S.Main.Stats}">
        <Grid Margin="10,8" MinHeight="140">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215" />
            <ColumnDefinition Width="215" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="1">
            <!-- Nur noch eine Ueberschrift. Die aktuelle Rate steht jetzt
                 beim Diagramm, wo sie hingehoert; NETZWERK stand danach vor
                 einem leeren Abschnitt.

                 Beide Richtungen in einer Zeile: untereinander waren es neun
                 Zeilen, und die letzte, die hoechste Rate, wurde am unteren
                 Rand abgeschnitten. -->
            <TextBlock Text="{DynamicResource S.Main.Session}" Style="{StaticResource Kopfzeile}" />

            <!-- Merkmal und Wert in zwei Spalten. Frei nebeneinandergesetzt
                 standen die Zahlen an drei verschiedenen Stellen, und beim
                 Vergleichen sucht das Auge dann jede einzeln. -->
            <Grid ToolTip="{DynamicResource S.Main.SessionTip}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Main.RecvSince}" VerticalAlignment="Center" />
              <TextBlock Grid.Row="0" Grid.Column="1" FontSize="14" Margin="0,0,0,2"
                         HorizontalAlignment="Right"><Run x:Name="TotalDown" Text="0 B" Foreground="{DynamicResource Ein}" /></TextBlock>

              <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Main.SentSince}" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Grid.Column="1" FontSize="14" Margin="0,0,0,2"
                         HorizontalAlignment="Right"><Run x:Name="TotalUp" Text="0 B" Foreground="{DynamicResource Aus}" /></TextBlock>

              <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Merkmal}"
                         Text="{DynamicResource S.Main.Peak}" VerticalAlignment="Center" />
              <TextBlock Grid.Row="2" Grid.Column="1" FontSize="14"
                         HorizontalAlignment="Right"><Run x:Name="PeakRate" Text="0 B/s" /></TextBlock>
            </Grid>

            <!-- Vorschau und Gesamtbestand stehen hier, weil links jetzt die
                 Laufwerke Platz brauchen. Es sind ohnehin Zahlen ueber alles
                 und nicht ueber ein einzelnes Laufwerk. -->
            <TextBlock Text="{DynamicResource S.Main.Preview}" Style="{StaticResource Kopfzeile}" Margin="0,10,0,4" />
            <TextBlock x:Name="ThumbText" Text="" Style="{StaticResource Beschriftung}" />

            <TextBlock Text="{DynamicResource S.Main.Overall}" Style="{StaticResource Kopfzeile}" Margin="0,10,0,4" />
            <TextBlock x:Name="OverallText" Text="—" Style="{StaticResource Beschriftung}" />
          </StackPanel>

          <!-- Die Zahlen stehen hier, also gehoert das Aufraeumen auch hierher
               und nicht nur in die Einstellungen. -->
          <StackPanel Grid.Column="0">
            <StackPanel.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{DynamicResource S.Menu.ClearCache}" Click="OnClearCache" />
                <MenuItem Header="{DynamicResource S.Menu.ClearThumbs}" Click="OnClearThumbnails" />
              </ContextMenu>
            </StackPanel.ContextMenu>

            <TextBlock Text="{DynamicResource S.Main.Cache}" Style="{StaticResource Kopfzeile}" />

            <!-- Eine Zeile je Laufwerk mit Freigabe. Eine Summe ueber alle
                 waere die falsche Zahl: das Limit gilt je Datentraeger, und
                 die Summe kann harmlos aussehen, waehrend ein einzelnes
                 Laufwerk seine Grenze schon ueberschreitet. -->
            <ItemsControl x:Name="CacheList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,10,4" ToolTip="{Binding Tip}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" MinWidth="40" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Drive}" Style="{StaticResource Beschriftung}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="100"
                                 Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource Beschriftung}"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="CacheText" Text="—" Style="{StaticResource Beschriftung}" />
          </StackPanel>

          <DockPanel Grid.Column="2" Margin="12,0,0,0">
            <!-- Die Rate steht in derselben Zeile wie die Zeitspannen. Sie
                 gehoert ohnehin zum Diagramm, denn es sind die beiden Linien
                 darin, und nimmt in der Spalte links keinen Platz mehr weg.
                 Die Zeitspannen bleiben mittig, die Rate steht am Rand. -->
            <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0">
              <TextBlock FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"><Run Text="&#x2193; " FontSize="11" Foreground="{DynamicResource Gedaempft}" /><Run x:Name="RateDown" Text="0 B/s" Foreground="{DynamicResource Ein}" /><Run Text="   &#x2191; " FontSize="11" Foreground="{DynamicResource Gedaempft}" /><Run x:Name="RateUp" Text="0 B/s" Foreground="{DynamicResource Aus}" /></TextBlock>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton x:Name="Range5" Content="{DynamicResource S.Main.Span5}" GroupName="Spanne" IsChecked="True"
                             Checked="OnRangeChanged" Margin="8,0" />
                <RadioButton x:Name="Range30" Content="{DynamicResource S.Main.Span30}" GroupName="Spanne"
                             Checked="OnRangeChanged" Margin="8,0" />
                <RadioButton x:Name="Range180" Content="{DynamicResource S.Main.Span180}" GroupName="Spanne"
                             Checked="OnRangeChanged" Margin="8,0" />
              </StackPanel>
            </Grid>
            <Border BorderBrush="{DynamicResource RahmenFein}" BorderThickness="1" Background="{DynamicResource Feld}" MinHeight="112">
              <local:ThroughputChart x:Name="Chart" />
            </Border>
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource S.Main.Transfers}">
        <!-- Zwei Spalten: was hinausgeht links, was hereinkommt rechts. In
             einer gemeinsamen Liste musste man je Zeile nachsehen, in welche
             Richtung sie lief; nebeneinander beantwortet die Spalte das. -->
        <Grid Margin="8,6,8,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource S.Main.Outgoing}"
                     Style="{StaticResource Kopfzeile}" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource S.Main.Incoming}"
                     Style="{StaticResource Kopfzeile}" />

          <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="UploadList" ItemTemplate="{StaticResource Uebertragung}"
                          Margin="0,0,4,0" />
          </ScrollViewer>

          <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DownloadList" ItemTemplate="{StaticResource Uebertragung}"
                          Margin="0,0,4,0" />
          </ScrollViewer>

          <TextBlock x:Name="QueueText" Grid.Row="1" Grid.ColumnSpan="3"
                     Foreground="{DynamicResource Gedaempft}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Text="{DynamicResource S.Main.Idle}" />
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource S.Main.Log}">
        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" BorderThickness="0" />
      </TabItem>
    </TabControl>


    <TextBlock x:Name="StatusBar" Grid.Row="4" Margin="10,6,10,8" Foreground="{DynamicResource Gedaempft}" />
  </Grid>
</Window>
