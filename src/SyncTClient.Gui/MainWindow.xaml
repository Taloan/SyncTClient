<Window x:Class="SyncTClient.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SyncTClient"
        Height="800" Width="1180"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded" Closing="OnClosing">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="330" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============== Links: Gegenstellen und deren Ordner ============== -->
    <Grid Grid.Row="0" Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="190" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Gegenstellen" FontWeight="SemiBold" Margin="0,0,0,4" />

      <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1">
        <ListBox x:Name="PeerList" BorderThickness="0" SelectionChanged="OnPeerSelected">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="2,4">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}"
                             Foreground="Gray" FontSize="11" Margin="8,0,0,0" />
                  <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock Text="{Binding Detail}" Foreground="Gray" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <WrapPanel Grid.Row="2" Margin="0,6,0,10">
        <Button Content="Server hinzufügen" Click="OnAddPeer" />
        <Button x:Name="ConnectButton" Content="Verbinden" Click="OnConnectPeer" />
        <Button Content="Entfernen" Click="OnRemovePeer" Margin="0" />
      </WrapPanel>

      <TextBlock Grid.Row="3" x:Name="FolderHeader" Text="Ordner" FontWeight="SemiBold" Margin="0,0,0,4" />

      <Border Grid.Row="4" BorderBrush="#DDD" BorderThickness="1">
        <ListBox x:Name="FolderList" BorderThickness="0" SelectionChanged="OnFolderSelected"
                 MouseDoubleClick="OnFolderDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="2,4">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}"
                             Foreground="Gray" FontSize="11" Margin="8,0,0,0" />
                  <TextBlock Text="{Binding Display}" />
                </DockPanel>
                <TextBlock Text="{Binding Detail}" Foreground="Gray" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <WrapPanel Grid.Row="5" Margin="0,6,0,0">
        <Button x:Name="AcceptButton" Content="Übernehmen" Click="OnAcceptFolder" />
        <Button x:Name="PauseButton" Content="Anhalten" Click="OnPauseShare" />
        <Button x:Name="UnbindButton" Content="Bindung lösen" Click="OnUnbind" Margin="0" />
      </WrapPanel>
    </Grid>

    <GridSplitter Grid.Row="0" Grid.Column="1" Width="4"
                  HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

    <!-- ============== Rechts: Reiter ============== -->
    <TabControl Grid.Row="0" Grid.Column="2">

      <TabItem Header="Status">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="ShareTitle" FontSize="16" FontWeight="SemiBold" Text="—" />
            <TextBlock x:Name="ShareSubtitle" Foreground="Gray" Text="" Margin="0,0,0,10" />

            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="Lokaler Cache" FontWeight="SemiBold" />
              <TextBlock x:Name="CacheText" DockPanel.Dock="Right" Foreground="Gray"
                         HorizontalAlignment="Right" Text="—" />
            </DockPanel>
            <ProgressBar x:Name="CacheBar" Height="14" Margin="0,4,0,0" Minimum="0" Maximum="100" />

            <UniformGrid Columns="4" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Einträge" Foreground="Gray" FontSize="11" />
                <TextBlock x:Name="StatIndex" Text="—" FontSize="15" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Gesamtgröße" Foreground="Gray" FontSize="11" />
                <TextBlock x:Name="StatSize" Text="—" FontSize="15" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Lokal" Foreground="Gray" FontSize="11" />
                <TextBlock x:Name="StatLocal" Text="—" FontSize="15" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Vorschaubilder" Foreground="Gray" FontSize="11" />
                <TextBlock x:Name="StatThumbs" Text="—" FontSize="15" />
              </StackPanel>
            </UniformGrid>
          </StackPanel>

          <DockPanel Grid.Row="1">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <TextBlock DockPanel.Dock="Left" Text="Übertragungen" FontWeight="SemiBold" />
              <TextBlock x:Name="QueueText" DockPanel.Dock="Right" Foreground="Gray"
                         HorizontalAlignment="Right" Text="" />
            </DockPanel>
            <Border BorderBrush="#DDD" BorderThickness="1">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TransferList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="8,6">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}"
                                     Foreground="Gray" Margin="8,0,0,0" />
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <DockPanel Margin="0,1,0,3">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Progress}"
                                     Foreground="Gray" FontSize="11" Margin="8,0,0,0" />
                          <TextBlock Text="{Binding Folder}" Foreground="Gray" FontSize="11"
                                     TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar Height="6" Minimum="0" Maximum="100"
                                     Value="{Binding Percent, Mode=OneWay}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </DockPanel>

          <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Protokoll" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" Margin="0" />
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Einstellungen">
        <Grid Margin="10" x:Name="DetailPanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <Label Content="Lokaler Pfad" />
            <TextBox x:Name="LocalPathBox" />

            <Label Content="Modus" />
            <ComboBox x:Name="ModeBox" SelectionChanged="OnModeChanged">
              <ComboBoxItem Content="Bei Bedarf herunterladen (Platzhalter)" />
              <ComboBoxItem Content="Vollständig lokal bereithalten" />
            </ComboBox>

            <StackPanel Orientation="Horizontal">
              <StackPanel Width="200" x:Name="CachePanel">
                <Label Content="Cache-Budget (MB)" />
                <TextBox x:Name="CacheBudgetBox" />
              </StackPanel>
              <StackPanel Margin="16,0,0,0" VerticalAlignment="Bottom">
                <CheckBox x:Name="ThumbsBox" Content="Vorschaubilder vorbereiten" Margin="0,0,0,6" />
                <CheckBox x:Name="AutoStartBox" Content="Beim Start automatisch hochfahren" Margin="0,0,0,12" />
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="CacheHint" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />
          </StackPanel>

          <DockPanel Grid.Row="1" Margin="0,8,0,4">
            <TextBlock DockPanel.Dock="Left" Text="Was soll überhaupt erscheinen?"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Nichts" Click="OnSelectNone" Margin="0" />
            <Button DockPanel.Dock="Right" Content="Alles" Click="OnSelectAll" />
            <TextBlock x:Name="TreeStatus" VerticalAlignment="Center" Margin="10,0" Foreground="Gray" />
          </DockPanel>

          <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1">
            <TreeView x:Name="FolderTree" BorderThickness="0">
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Margin="0,1">
                    <!-- IsThreeState bleibt aus: der unbestimmte Zustand ergibt
                         sich aus den Kindern, anklicken laesst er sich nicht. -->
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              IsThreeState="False" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary}" Margin="10,0,0,0"
                               Foreground="Gray" VerticalAlignment="Center" />
                  </StackPanel>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Border>

          <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Speichern" Click="OnSave" Margin="0" />
            <TextBlock x:Name="SaveHint" Foreground="Gray" VerticalAlignment="Center"
                       Text="Änderungen greifen, wenn die Freigabe neu gestartet wird." />
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Dieses Gerät">
        <StackPanel Margin="14">
          <TextBlock Text="Eigene Device-ID" FontWeight="SemiBold" />
          <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,8"
                     Text="Diese Kennung auf der Gegenstelle als Gerät eintragen und die gewünschten Ordner damit teilen. Danach erscheinen sie hier unter „Ordner“ als angeboten." />
          <TextBox x:Name="OwnIdBox" IsReadOnly="True" FontFamily="Consolas"
                   TextWrapping="Wrap" Padding="8" />
          <Button Content="In die Zwischenablage" Click="OnCopyId"
                  HorizontalAlignment="Left" Margin="0,8,0,0" />

          <TextBlock Text="Konfigurationsdatei" FontWeight="SemiBold" Margin="0,20,0,2" />
          <TextBox x:Name="ConfigPathBox" IsReadOnly="True" />

          <TextBlock Text="Vorschaubilder" FontWeight="SemiBold" Margin="0,20,0,2" />
          <TextBlock x:Name="ThumbInfo" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <TextBlock x:Name="StatusBar" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Foreground="Gray" />
  </Grid>
</Window>
