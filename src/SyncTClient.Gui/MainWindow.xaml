<Window x:Class="SyncTClient.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SyncTClient.Gui"
        Title="SyncTClient"
        Height="820" Width="1280" MinWidth="1000" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded" Closing="OnClosing"
        Background="{DynamicResource Flaeche}">

  <Window.Resources>
    <Style x:Key="Kopfzeile" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Gedaempft}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Kennzahl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="Beschriftung" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Gedaempft}" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="120" />
      <RowDefinition Height="Auto" />
      <RowDefinition x:Name="BottomRow" Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===================== Werkzeugleiste ===================== -->
    <DockPanel Grid.Row="0" Margin="10,8,10,8">
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Main.Device}" Click="OnShowDevice" Margin="0" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Main.Peers}" Click="OnManagePeers" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Main.Settings}" Click="OnShowProgramSettings" />
      <Button x:Name="PauseAllButton" DockPanel.Dock="Left"
              Content="{DynamicResource S.Main.PauseAll}" Click="OnTogglePauseAll" />
      <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Gedaempft}"
                 Text="{DynamicResource S.Main.MenuHint}" />
    </DockPanel>

    <!-- ===================== Freigaben ===================== -->
    <DataGrid x:Name="ShareGrid" Grid.Row="1" Margin="10,0,10,0"
              AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
              SelectionMode="Single" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource RahmenFein}"
              BorderBrush="{DynamicResource Rahmen}" BorderThickness="1" RowHeight="30"
              SelectionChanged="OnShareSelected" MouseDoubleClick="OnGridDoubleClick"
              PreviewMouseRightButtonDown="OnGridRightClick">
      <DataGrid.Columns>

        <DataGridTemplateColumn x:Name="ColName" Header="{DynamicResource S.Col.Name}" Width="240"
                                SortMemberPath="Name" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="{DynamicResource Symbol}" Margin="4,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>

          <!-- Umbenennen wie im Explorer: Klick, Pause, Klick. Ein
               Doppelklick oeffnet weiterhin den Ordner. -->
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <TextBox x:Name="NameEditor" Margin="2,0"
                       Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                       Loaded="OnNameEditorLoaded" />
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{DynamicResource S.Col.Status}" Width="190" SortMemberPath="StatusText" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{DynamicResource Gut}" VerticalAlignment="Center" Margin="0,0,6,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Ready}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{DynamicResource Sekundaer}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn x:Name="ColPeers" Width="60"
                                SortMemberPath="PeersText" CanUserSort="True">
          <!-- Gezeichnet statt beschriftet: die Spalte traegt eine Ziffer,
               eine Ueberschrift aus zwei Woertern waere breiter als ihr
               Inhalt. Der Name steht im Tooltip. -->
          <DataGridTemplateColumn.Header>
            <Canvas Width="18" Height="16" Background="Transparent"
                    ToolTip="{DynamicResource S.Col.Nodes}">
              <Line X1="4" Y1="5" X2="13" Y2="5" Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
              <Line X1="4" Y1="5" X2="8.5" Y2="12" Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
              <Line X1="13" Y1="5" X2="8.5" Y2="12" Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
              <Ellipse Canvas.Left="1.5" Canvas.Top="2.5" Width="5" Height="5" Fill="{DynamicResource Sekundaer}" />
              <Ellipse Canvas.Left="10.5" Canvas.Top="2.5" Width="5" Height="5" Fill="{DynamicResource Sekundaer}" />
              <Ellipse Canvas.Left="6" Canvas.Top="9.5" Width="5" Height="5" Fill="{DynamicResource Sekundaer}" />
            </Canvas>
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock VerticalAlignment="Center" Margin="4,0">
                <Hyperlink Click="OnShowPeers" ToolTip="{DynamicResource S.Main.NodesTip}">
                  <Run Text="{Binding PeersText, Mode=OneWay}" />
                </Hyperlink>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn x:Name="ColProgress" Header="{DynamicResource S.Col.Progress}" Width="200"
                                SortMemberPath="Percent" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Grid VerticalAlignment="Center" Margin="4,0">
                <ProgressBar Height="12" Minimum="0" Maximum="100"
                             Value="{Binding Percent, Mode=OneWay}"
                             IsIndeterminate="{Binding Indeterminate, Mode=OneWay}">
                  <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Busy}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="{Binding ProgressText}" FontSize="10" Foreground="{DynamicResource Sekundaer}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn x:Name="ColCopies" Width="60"
                                SortMemberPath="Copies" CanUserSort="True">
          <!-- Eine Wolke: wie viele Knoten den Inhalt liefern koennen. -->
          <DataGridTemplateColumn.Header>
            <Path Width="18" Height="14" Stretch="Uniform"
                  Fill="{DynamicResource Sekundaer}"
                  ToolTip="{DynamicResource S.Col.Copies}"
                  Data="M4.4,12.6 C2.5,12.6 1,11.1 1,9.3 C1,7.7 2.2,6.3 3.7,6.1
                        C4.1,4.1 5.9,2.6 8,2.6 C10.2,2.6 12,4.2 12.3,6.3
                        C13.9,6.6 15,7.9 15,9.5 C15,11.2 13.6,12.6 11.9,12.6 Z" />
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"
                          ToolTip="{Binding CopiesHint}">
                <TextBlock Text="{Binding CopiesText}" VerticalAlignment="Center" />
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{DynamicResource Warnung}" Margin="6,0,0,0" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding CopiesAtRisk}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Pfeil statt Wort: die Spalte traegt eine kurze Zahl, eine
             Ueberschrift aus einem ganzen Wort waere breiter als ihr Inhalt.
             Die Bedeutung steht im Tooltip und im Spaltenmenue. -->
        <DataGridTextColumn x:Name="ColReceived" Width="80"
                            Binding="{Binding ReceivedText}" SortMemberPath="ReceivedValue">
          <DataGridTextColumn.Header>
            <TextBlock Text="&#x2193;" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource Sekundaer}"
                       ToolTip="{DynamicResource S.Col.Received}" />
          </DataGridTextColumn.Header>
        </DataGridTextColumn>

        <DataGridTextColumn x:Name="ColSent" Width="80"
                            Binding="{Binding SentText}" SortMemberPath="SentValue">
          <DataGridTextColumn.Header>
            <TextBlock Text="&#x2191;" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource Sekundaer}"
                       ToolTip="{DynamicResource S.Col.Sent}" />
          </DataGridTextColumn.Header>
        </DataGridTextColumn>


        <DataGridTextColumn x:Name="ColSize" Header="{DynamicResource S.Col.Size}" Width="95"
                            Binding="{Binding SizeText}" SortMemberPath="SizeValue" />

        <DataGridTextColumn x:Name="ColLocalFiles" Width="85"
                            Binding="{Binding LocalFilesText}" SortMemberPath="LocalFilesValue">
          <DataGridTextColumn.Header>
            <StackPanel Orientation="Horizontal" Background="Transparent"
                        ToolTip="{DynamicResource S.Col.LocalFiles}">
              <Canvas Width="16" Height="12" VerticalAlignment="Center" Margin="0,0,5,0">
                <Rectangle Canvas.Left="1" Canvas.Top="2" Width="14" Height="8" RadiusX="1.5" RadiusY="1.5"
                           Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
                <Line X1="1" Y1="7" X2="15" Y2="7" Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
                <Ellipse Canvas.Left="11" Canvas.Top="7.8" Width="2.4" Height="2.4"
                         Fill="{DynamicResource Sekundaer}" />
              </Canvas>
              <TextBlock Text="{DynamicResource S.Col.Files}" VerticalAlignment="Center" />
            </StackPanel>
          </DataGridTextColumn.Header>
        </DataGridTextColumn>

        <DataGridTextColumn x:Name="ColLocalSize" Width="95" Visibility="Collapsed"
                            Binding="{Binding LocalSizeText}" SortMemberPath="LocalSizeValue">
          <DataGridTextColumn.Header>
            <StackPanel Orientation="Horizontal" Background="Transparent"
                        ToolTip="{DynamicResource S.Col.LocalSize}">
              <Canvas Width="16" Height="12" VerticalAlignment="Center" Margin="0,0,5,0">
                <Rectangle Canvas.Left="1" Canvas.Top="2" Width="14" Height="8" RadiusX="1.5" RadiusY="1.5"
                           Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
                <Line X1="1" Y1="7" X2="15" Y2="7" Stroke="{DynamicResource Sekundaer}" StrokeThickness="1.2" />
                <Ellipse Canvas.Left="11" Canvas.Top="7.8" Width="2.4" Height="2.4"
                         Fill="{DynamicResource Sekundaer}" />
              </Canvas>
              <TextBlock Text="{DynamicResource S.Col.Size}" VerticalAlignment="Center" />
            </StackPanel>
          </DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn x:Name="ColFiles" Header="{DynamicResource S.Col.Files}" Width="90" Visibility="Collapsed"
                            Binding="{Binding FilesText}" SortMemberPath="FilesValue" />
        <DataGridTextColumn x:Name="ColThumbs" Header="{DynamicResource S.Col.Thumbs}" Width="110" Visibility="Collapsed"
                            Binding="{Binding ThumbsText}" SortMemberPath="ThumbsValue" />
        <DataGridTextColumn x:Name="ColBudget" Header="{DynamicResource S.Col.Budget}" Width="110" Visibility="Collapsed"
                            Binding="{Binding BudgetText}" SortMemberPath="BudgetValue" />
        <DataGridTextColumn x:Name="ColMode" Header="{DynamicResource S.Col.Mode}" Width="130" Visibility="Collapsed"
                            Binding="{Binding ModeText}" />
        <DataGridTextColumn x:Name="ColLast" Header="{DynamicResource S.Col.LastTransfer}" Width="130" Visibility="Collapsed"
                            Binding="{Binding LastTransferText}" SortMemberPath="LastTransferValue" />
        <DataGridTextColumn x:Name="ColPeer" Header="{DynamicResource S.Col.Peer}" Width="150" Visibility="Collapsed"
                            Binding="{Binding PeerText}" />
        <DataGridTextColumn x:Name="ColFolderId" Header="{DynamicResource S.Col.FolderId}" Width="120" Visibility="Collapsed"
                            Binding="{Binding FolderId}" />
        <DataGridTemplateColumn x:Name="ColPath" Header="{DynamicResource S.Col.Folder}" Width="*"
                                SortMemberPath="PathText" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis">
                <Hyperlink Click="OnOpenPath" ToolTip="{Binding PathText}">
                  <Run Text="{Binding PathText, Mode=OneWay}" />
                </Hyperlink>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter x:Name="Splitter" Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                  VerticalAlignment="Center" Background="Transparent" />

    <!-- ===================== Unterer Bereich ===================== -->
    <!-- Ein Bereich statt dreier untereinander. Die Höhe teilt sich der
         Bereich mit der Liste darüber; der Griff dazwischen verschiebt sie. -->
    <TabControl x:Name="BottomTabs" Grid.Row="3" Margin="10,0,10,0"
                BorderBrush="{DynamicResource Rahmen}">

      <TabItem Header="{DynamicResource S.Main.Stats}">
        <Grid Margin="10,8" MinHeight="140">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215" />
            <ColumnDefinition Width="215" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="1">
            <!-- Nur noch eine Ueberschrift. Die aktuelle Rate steht jetzt
                 beim Diagramm, wo sie hingehoert; NETZWERK stand danach vor
                 einem leeren Abschnitt.

                 Beide Richtungen in einer Zeile: untereinander waren es neun
                 Zeilen, und die letzte, die hoechste Rate, wurde am unteren
                 Rand abgeschnitten. -->
            <TextBlock Text="{DynamicResource S.Main.Session}" Style="{StaticResource Kopfzeile}" />
            <TextBlock FontSize="14" Margin="0,0,0,3" ToolTip="{DynamicResource S.Main.SessionTip}"><Run Text="&#x2193; " FontSize="11" Foreground="{DynamicResource Gedaempft}" /><Run x:Name="TotalDown" Text="0 B" Foreground="{DynamicResource Ein}" /><Run Text="   &#x2191; " FontSize="11" Foreground="{DynamicResource Gedaempft}" /><Run x:Name="TotalUp" Text="0 B" Foreground="{DynamicResource Aus}" /></TextBlock>
            <TextBlock FontSize="14"><Run Text="{DynamicResource S.Main.Peak}" FontSize="11" Foreground="{DynamicResource Gedaempft}" /><Run Text=" " /><Run x:Name="PeakRate" Text="0 B/s" /></TextBlock>
          </StackPanel>

          <!-- Die Zahlen stehen hier, also gehoert das Aufraeumen auch hierher
               und nicht nur in die Einstellungen. -->
          <StackPanel Grid.Column="0">
            <StackPanel.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{DynamicResource S.Menu.ClearCache}" Click="OnClearCache" />
                <MenuItem Header="{DynamicResource S.Menu.ClearThumbs}" Click="OnClearThumbnails" />
              </ContextMenu>
            </StackPanel.ContextMenu>

            <TextBlock Text="{DynamicResource S.Main.Cache}" Style="{StaticResource Kopfzeile}" />
            <TextBlock x:Name="CacheText" Text="—" Style="{StaticResource Beschriftung}" />
            <ProgressBar x:Name="CacheBar" Height="8" Minimum="0" Maximum="100" Margin="0,3,10,0" />
            <TextBlock x:Name="FreeText" Text="—" Style="{StaticResource Beschriftung}" Margin="0,3,0,0" />

            <TextBlock Text="{DynamicResource S.Main.Preview}" Style="{StaticResource Kopfzeile}" Margin="0,10,0,4" />
            <TextBlock x:Name="ThumbText" Text="" Style="{StaticResource Beschriftung}" />
          </StackPanel>

          <DockPanel Grid.Column="2" Margin="12,0,0,0">
            <!-- Die Rate steht in derselben Zeile wie die Zeitspannen. Sie
                 gehoert ohnehin zum Diagramm, denn es sind die beiden Linien
                 darin, und nimmt in der Spalte links keinen Platz mehr weg.
                 Die Zeitspannen bleiben mittig, die Rate steht am Rand. -->
            <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0">
              <TextBlock FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"><Run Text="&#x2193; " FontSize="11" Foreground="{DynamicResource Gedaempft}" /><Run x:Name="RateDown" Text="0 B/s" Foreground="{DynamicResource Ein}" /><Run Text="   &#x2191; " FontSize="11" Foreground="{DynamicResource Gedaempft}" /><Run x:Name="RateUp" Text="0 B/s" Foreground="{DynamicResource Aus}" /></TextBlock>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton x:Name="Range5" Content="{DynamicResource S.Main.Span5}" GroupName="Spanne" IsChecked="True"
                             Checked="OnRangeChanged" Margin="8,0" />
                <RadioButton x:Name="Range30" Content="{DynamicResource S.Main.Span30}" GroupName="Spanne"
                             Checked="OnRangeChanged" Margin="8,0" />
                <RadioButton x:Name="Range180" Content="{DynamicResource S.Main.Span180}" GroupName="Spanne"
                             Checked="OnRangeChanged" Margin="8,0" />
              </StackPanel>
            </Grid>
            <Border BorderBrush="{DynamicResource RahmenFein}" BorderThickness="1" Background="{DynamicResource Feld}" MinHeight="112">
              <local:ThroughputChart x:Name="Chart" />
            </Border>
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource S.Main.Transfers}">
        <DockPanel>
          <TextBlock x:Name="QueueText" DockPanel.Dock="Top" Foreground="{DynamicResource Gedaempft}"
                     Margin="8,6,8,4" Text="{DynamicResource S.Main.Idle}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TransferList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- Eine Zeile je Datei, nicht so breit wie das Fenster. Der
                       Fortschritt ist auf 700 Punkten so gut abzulesen wie auf
                       zweitausend, und der Blick muss weniger wandern. -->
                  <StackPanel Margin="8,4" MaxWidth="700" HorizontalAlignment="Left">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}"
                                 Foreground="{DynamicResource Gedaempft}" Margin="8,0,0,0" />
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel Margin="0,1,0,3">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Progress}"
                                 Foreground="{DynamicResource Gedaempft}" FontSize="11" Margin="8,0,0,0" />
                      <TextBlock Text="{Binding Folder}" Foreground="{DynamicResource Gedaempft}" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar Height="5" Minimum="0" Maximum="100"
                                 Value="{Binding Percent, Mode=OneWay}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="{DynamicResource S.Main.Log}">
        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" BorderThickness="0" />
      </TabItem>
    </TabControl>


    <TextBlock x:Name="StatusBar" Grid.Row="4" Margin="10,6,10,8" Foreground="{DynamicResource Gedaempft}" />
  </Grid>
</Window>
