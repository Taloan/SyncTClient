<Window x:Class="SyncTClient.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SyncTClient"
        Height="760" Width="1040"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Kopf: Freigabe, Zustand, Steuerung -->
    <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="1" Padding="10" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="Freigabe" Foreground="Gray" FontSize="11" />
          <ComboBox x:Name="ShareBox" SelectionChanged="OnShareSelected"
                    DisplayMemberPath="FolderId" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="StateText" FontSize="16" FontWeight="SemiBold" Text="—" />
          <TextBlock x:Name="StateDetail" Foreground="Gray" Text="" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="StartButton" Content="Starten" Click="OnStart" MinWidth="90" />
          <Button x:Name="PauseButton" Content="Anhalten" Click="OnPause" MinWidth="90" />
          <Button x:Name="StopButton" Content="Stoppen" Click="OnStop" MinWidth="90" Margin="0" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1">

      <!-- ============================ Status ============================ -->
      <TabItem Header="Status">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
          </Grid.RowDefinitions>

          <!-- Cache -->
          <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="Lokaler Cache" FontWeight="SemiBold" />
              <TextBlock x:Name="CacheText" DockPanel.Dock="Right" Foreground="Gray"
                         HorizontalAlignment="Right" Text="—" />
            </DockPanel>
            <ProgressBar x:Name="CacheBar" Height="14" Margin="0,4,0,0" Minimum="0" Maximum="100" />
            <TextBlock x:Name="IndexText" Foreground="Gray" Margin="0,4,0,0" Text="" />
          </StackPanel>

          <!-- Übertragungen -->
          <DockPanel Grid.Row="1">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <TextBlock DockPanel.Dock="Left" Text="Übertragungen" FontWeight="SemiBold" />
              <TextBlock x:Name="QueueText" DockPanel.Dock="Right" Foreground="Gray"
                         HorizontalAlignment="Right" Text="" />
            </DockPanel>

            <Border BorderBrush="#DDD" BorderThickness="1">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TransferList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- Untereinander statt in festen Spalten: so bleibt alles
                           lesbar, auch wenn das Fenster schmal steht. -->
                      <StackPanel Margin="8,6">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}"
                                     Foreground="Gray" Margin="8,0,0,0" />
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <DockPanel Margin="0,1,0,3">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Progress}"
                                     Foreground="Gray" FontSize="11" Margin="8,0,0,0" />
                          <TextBlock Text="{Binding Folder}" Foreground="Gray" FontSize="11"
                                     TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar Height="6" Minimum="0" Maximum="100"
                                     Value="{Binding Percent, Mode=OneWay}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </DockPanel>

          <!-- Protokoll -->
          <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Protokoll" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" Margin="0" />
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- ========================= Einstellungen ========================= -->
      <TabItem Header="Einstellungen">
        <Grid Margin="10" x:Name="DetailPanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <Label Content="Konfigurationsdatei" />
            <TextBox x:Name="ConfigPathBox" IsReadOnly="True" />

            <Label Content="Lokaler Pfad" />
            <TextBox x:Name="LocalPathBox" />

            <Label Content="Modus" />
            <ComboBox x:Name="ModeBox" SelectionChanged="OnModeChanged">
              <ComboBoxItem Content="Bei Bedarf herunterladen (Platzhalter)" />
              <ComboBoxItem Content="Vollständig lokal bereithalten" />
            </ComboBox>

            <StackPanel x:Name="CachePanel" Orientation="Horizontal">
              <StackPanel Width="200">
                <Label Content="Cache-Budget (MB)" />
                <TextBox x:Name="CacheBudgetBox" />
              </StackPanel>
              <TextBlock x:Name="CacheHint" VerticalAlignment="Bottom" Margin="12,0,0,12"
                         Foreground="Gray" TextWrapping="Wrap" Width="480" />
            </StackPanel>
          </StackPanel>

          <DockPanel Grid.Row="1" Margin="0,8,0,4">
            <TextBlock DockPanel.Dock="Left" Text="Was soll überhaupt erscheinen?"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Nichts" Click="OnSelectNone" Margin="0" />
            <Button DockPanel.Dock="Right" Content="Alles" Click="OnSelectAll" />
            <TextBlock x:Name="TreeStatus" VerticalAlignment="Center" Margin="10,0" Foreground="Gray" />
          </DockPanel>

          <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1">
            <TreeView x:Name="FolderTree" BorderThickness="0">
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Margin="0,1">
                    <!-- IsThreeState bleibt aus: der unbestimmte Zustand ergibt
                         sich aus den Kindern, anklicken laesst er sich nicht. -->
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              IsThreeState="False" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary}" Margin="10,0,0,0"
                               Foreground="Gray" VerticalAlignment="Center" />
                  </StackPanel>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Border>

          <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Speichern" Click="OnSave" Margin="0" />
            <Button DockPanel.Dock="Right" Content="Neu laden" Click="OnReload" />
            <TextBlock x:Name="SaveHint" Foreground="Gray" VerticalAlignment="Center"
                       Text="Änderungen greifen, wenn die Freigabe neu gestartet wird." />
          </DockPanel>
        </Grid>
      </TabItem>
    </TabControl>

    <TextBlock x:Name="StatusBar" Grid.Row="2" Margin="0,10,0,0" Foreground="Gray" />
  </Grid>
</Window>
