<Window x:Class="SyncTClient.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SyncTClient.Gui"
        Title="SyncTClient"
        Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded" Closing="OnClosing">

  <Window.Resources>
    <Style x:Key="Kopfzeile" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#888" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Kennzahl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="Beschriftung" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#888" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="140" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="170" MinHeight="0" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===================== Werkzeugleiste ===================== -->
    <DockPanel Grid.Row="0" Margin="10,8,10,8">
      <Button DockPanel.Dock="Right" Content="Dieses Gerät" Click="OnShowDevice" Margin="0" />
      <Button DockPanel.Dock="Right" Content="Gegenstellen …" Click="OnManagePeers" />
      <WrapPanel>
        <Button x:Name="AcceptButton" Content="Übernehmen" Click="OnAcceptFolder" />
        <Button x:Name="PauseButton" Content="Anhalten" Click="OnPauseShare" />
        <Button x:Name="SettingsButton" Content="Einstellungen" Click="OnShowSettings" />
        <Button x:Name="OpenButton" Content="Ordner öffnen" Click="OnOpenFolder" />
        <Button x:Name="UnbindButton" Content="Bindung lösen" Click="OnUnbind" />
      </WrapPanel>
    </DockPanel>

    <!-- ===================== Freigaben ===================== -->
    <DataGrid x:Name="ShareGrid" Grid.Row="1" Margin="10,0,10,0"
              AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
              SelectionMode="Single" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
              BorderBrush="#DDD" BorderThickness="1" RowHeight="30"
              SelectionChanged="OnShareSelected" MouseDoubleClick="OnGridDoubleClick">
      <DataGrid.Columns>

        <DataGridTemplateColumn Header="Name" Width="240" SortMemberPath="Name" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="#B0B0B0" Margin="4,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="Status" Width="190" SortMemberPath="StatusText" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="#2E9E4F" VerticalAlignment="Center" Margin="0,0,6,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Ready}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#555" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn x:Name="ColPeers" Header="Knoten online" Width="110"
                                SortMemberPath="PeersText" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock VerticalAlignment="Center" Margin="4,0">
                <Hyperlink Click="OnShowPeers" ToolTip="Wer trägt diesen Ordner?">
                  <Run Text="{Binding PeersText, Mode=OneWay}" />
                </Hyperlink>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn x:Name="ColProgress" Header="Fortschritt" Width="200"
                                SortMemberPath="Percent" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Grid VerticalAlignment="Center" Margin="4,0">
                <ProgressBar Height="12" Minimum="0" Maximum="100"
                             Value="{Binding Percent, Mode=OneWay}"
                             IsIndeterminate="{Binding Indeterminate, Mode=OneWay}">
                  <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Busy}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="{Binding ProgressText}" FontSize="10" Foreground="#666"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn x:Name="ColReceived" Header="Empfangen" Width="95"
                            Binding="{Binding ReceivedText}" SortMemberPath="ReceivedValue" />

        <DataGridTextColumn x:Name="ColSize" Header="Größe" Width="95"
                            Binding="{Binding SizeText}" SortMemberPath="SizeValue" />

        <DataGridTextColumn x:Name="ColLocalFiles" Header="Lokale Dateien" Width="105"
                            Binding="{Binding LocalFilesText}" SortMemberPath="LocalFilesValue" />

        <DataGridTextColumn x:Name="ColLocalSize" Header="Lokale Größe" Width="105" Visibility="Collapsed"
                            Binding="{Binding LocalSizeText}" SortMemberPath="LocalSizeValue" />
        <DataGridTextColumn x:Name="ColFiles" Header="Dateien" Width="90" Visibility="Collapsed"
                            Binding="{Binding FilesText}" SortMemberPath="FilesValue" />
        <DataGridTextColumn x:Name="ColThumbs" Header="Vorschaubilder" Width="110" Visibility="Collapsed"
                            Binding="{Binding ThumbsText}" SortMemberPath="ThumbsValue" />
        <DataGridTextColumn x:Name="ColBudget" Header="Cache-Budget" Width="110" Visibility="Collapsed"
                            Binding="{Binding BudgetText}" SortMemberPath="BudgetValue" />
        <DataGridTextColumn x:Name="ColMode" Header="Modus" Width="130" Visibility="Collapsed"
                            Binding="{Binding ModeText}" />
        <DataGridTextColumn x:Name="ColLast" Header="Zuletzt übertragen" Width="130" Visibility="Collapsed"
                            Binding="{Binding LastTransferText}" SortMemberPath="LastTransferValue" />
        <DataGridTextColumn x:Name="ColPeer" Header="Gegenstelle" Width="150" Visibility="Collapsed"
                            Binding="{Binding PeerText}" />
        <DataGridTextColumn x:Name="ColFolderId" Header="Ordner-ID" Width="120" Visibility="Collapsed"
                            Binding="{Binding FolderId}" />
        <DataGridTextColumn x:Name="ColPath" Header="Pfad" Width="*" Visibility="Collapsed"
                            Binding="{Binding PathText}" />
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                  VerticalAlignment="Center" Background="Transparent" />

    <!-- ===================== Übertragungen und Protokoll ===================== -->
    <TabControl Grid.Row="3" Margin="10,0,10,0" BorderBrush="#DDD">
      <TabItem Header="Übertragungen">
        <DockPanel>
          <TextBlock x:Name="QueueText" DockPanel.Dock="Top" Foreground="Gray"
                     Margin="8,6,8,4" Text="nichts unterwegs" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TransferList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="8,4">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}"
                                 Foreground="Gray" Margin="8,0,0,0" />
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel Margin="0,1,0,3">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Progress}"
                                 Foreground="Gray" FontSize="11" Margin="8,0,0,0" />
                      <TextBlock Text="{Binding Folder}" Foreground="Gray" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar Height="5" Minimum="0" Maximum="100"
                                 Value="{Binding Percent, Mode=OneWay}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Protokoll">
        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" BorderThickness="0" />
      </TabItem>
    </TabControl>

    <!-- ===================== Leiste: Netzwerk, Diagramm, Sitzung ===================== -->
    <Border Grid.Row="4" BorderBrush="#DDD" BorderThickness="0,1,0,0" Background="#FAFAFA"
            Margin="0,8,0,0" Padding="10,8">
      <Grid Height="128">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="176" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="NETZWERK" Style="{StaticResource Kopfzeile}" />
          <TextBlock Text="Empfangen" Style="{StaticResource Beschriftung}" />
          <TextBlock x:Name="RateDown" Text="0 B/s" Style="{StaticResource Kennzahl}"
                     Foreground="#1E88E5" Margin="0,0,0,4" />
          <TextBlock Text="Gesendet" Style="{StaticResource Beschriftung}" />
          <TextBlock x:Name="RateUp" Text="0 B/s" Style="{StaticResource Kennzahl}"
                     Foreground="#43A047" Margin="0,0,0,10" />

          <TextBlock Text="CACHE" Style="{StaticResource Kopfzeile}" />
          <TextBlock x:Name="CacheText" Text="—" Style="{StaticResource Beschriftung}" />
          <ProgressBar x:Name="CacheBar" Height="8" Minimum="0" Maximum="100" Margin="0,3,10,0" />
        </StackPanel>

        <DockPanel Grid.Column="1" Margin="12,0">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                      HorizontalAlignment="Center" Margin="0,4,0,0">
            <RadioButton x:Name="Range5" Content="5 Minuten" GroupName="Spanne" IsChecked="True"
                         Checked="OnRangeChanged" Margin="8,0" />
            <RadioButton x:Name="Range30" Content="30 Minuten" GroupName="Spanne"
                         Checked="OnRangeChanged" Margin="8,0" />
            <RadioButton x:Name="Range180" Content="3 Stunden" GroupName="Spanne"
                         Checked="OnRangeChanged" Margin="8,0" />
          </StackPanel>
          <Border BorderBrush="#E4E4E4" BorderThickness="1" Background="White">
            <local:ThroughputChart x:Name="Chart" />
          </Border>
        </DockPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="SITZUNG" Style="{StaticResource Kopfzeile}" />
          <TextBlock Text="Empfangen seit Programmstart" Style="{StaticResource Beschriftung}" />
          <TextBlock x:Name="TotalDown" Text="0 B" Style="{StaticResource Kennzahl}" Margin="0,0,0,4" />
          <TextBlock Text="Gesendet seit Programmstart" Style="{StaticResource Beschriftung}" />
          <TextBlock x:Name="TotalUp" Text="0 B" Style="{StaticResource Kennzahl}" Margin="0,0,0,4" />
          <TextBlock Text="Höchste Rate" Style="{StaticResource Beschriftung}" />
          <TextBlock x:Name="PeakRate" Text="0 B/s" Style="{StaticResource Kennzahl}" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock x:Name="StatusBar" Grid.Row="5" Margin="10,6,10,8" Foreground="Gray" />
  </Grid>
</Window>
