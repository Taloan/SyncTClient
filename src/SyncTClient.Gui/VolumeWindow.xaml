<Window x:Class="SyncTClient.Gui.VolumeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Vol.Title}"
        Width="820" Height="600" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Flaeche}">
  <!-- Was auf diesem Datentraeger als Platzhalter gefuehrt wird, ueber alle
       Freigaben hinweg. Das Kaestchen sagt, ob der Inhalt hier liegen soll. -->
  <DockPanel Margin="12">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
      <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource Gedaempft}"
                 TextWrapping="Wrap" Margin="0,2,0,0" />
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Cancel}" IsCancel="True" Margin="0" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Apply}" Click="OnApply" IsDefault="True" />
      <TextBlock x:Name="Hint" Foreground="{DynamicResource Gedaempft}" TextWrapping="Wrap"
                 VerticalAlignment="Center" Margin="0,0,12,0" />
    </DockPanel>

    <Border BorderBrush="{DynamicResource Rahmen}" BorderThickness="1">
      <TreeView x:Name="Tree" BorderThickness="0">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
              <!-- Dreistufig: ein Verzeichnis, in dem manches lokal liegt und
                   manches nicht, ist weder das eine noch das andere. -->
              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        IsThreeState="True" VerticalAlignment="Center"
                        ToolTip="{DynamicResource S.Vol.BoxHint}" />
              <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Summary}" Margin="10,0,0,0"
                         Foreground="{DynamicResource Gedaempft}" VerticalAlignment="Center" />
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Border>
  </DockPanel>
</Window>
