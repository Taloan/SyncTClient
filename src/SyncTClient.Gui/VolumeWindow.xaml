<Window x:Class="SyncTClient.Gui.VolumeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Vol.Title}"
        Width="820" Height="600" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Flaeche}">
  <!-- Was auf diesem Datentraeger als Platzhalter gefuehrt wird, ueber alle
       Freigaben hinweg. Das Kaestchen sagt, ob der Inhalt hier liegen soll. -->
  <DockPanel Margin="12">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
      <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource Gedaempft}"
                 TextWrapping="Wrap" Margin="0,2,0,0" />
      <TextBlock Text="{DynamicResource S.Vol.Explain}" Foreground="{DynamicResource Gedaempft}"
                 FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>

    <!-- Die Grenzen dieses Datentraegers. Sie standen einmal in den
         Einstellungen des Programms, als Liste ueber alle Laufwerke. Hier
         gehoeren sie hin: dieses Fenster ist ohnehin auf ein Laufwerk
         bezogen, und die Zahl darueber nennt genau dessen Belegung. -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="{DynamicResource S.Vol.LimitsGroup}" FontSize="10" FontWeight="SemiBold"
                 Foreground="{DynamicResource Gedaempft}" Margin="0,0,0,4" />

      <Border BorderBrush="{DynamicResource Rahmen}" BorderThickness="1" CornerRadius="3" Padding="10,8">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource S.Settings.UseLimit}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="MaxGbBox" Width="70" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource S.Settings.UseLimitNote}"
                       Foreground="{DynamicResource Gedaempft}" FontSize="11"
                       VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource S.Settings.KeepLimit}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,6,0" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="MinFreeGbBox" Width="70" Margin="0,6,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource S.Settings.KeepLimitNote}"
                       Foreground="{DynamicResource Gedaempft}" FontSize="11"
                       VerticalAlignment="Center" Margin="8,6,0,0" TextWrapping="Wrap" />
          </Grid>

          <TextBlock Text="{DynamicResource S.Settings.LimitsLead}" Foreground="{DynamicResource Gedaempft}"
                     FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />

          <TextBlock x:Name="EvictText" TextWrapping="Wrap" Margin="0,10,0,0" />
          <Button x:Name="ReleaseButton" Padding="10,3" HorizontalAlignment="Left"
                  Margin="0,4,0,0" IsEnabled="False" Click="OnRelease" />
        </StackPanel>
      </Border>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="{DynamicResource S.Cancel}" IsCancel="True" Margin="0" />
      <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="{DynamicResource S.Apply}"
              Click="OnApply" IsDefault="True" IsEnabled="False" />
      <TextBlock x:Name="Hint" Foreground="{DynamicResource Gedaempft}" TextWrapping="Wrap"
                 VerticalAlignment="Center" Margin="0,0,12,0" />
    </DockPanel>

    <Border BorderBrush="{DynamicResource Rahmen}" BorderThickness="1">
      <Grid>
        <!-- Solange gesammelt wird, steht hier ein Satz statt einer leeren
             Flaeche. Der Aufbau geht ueber den Index jeder Freigabe dieses
             Datentraegers; bei hunderttausend Eintraegen dauert das. -->
        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource S.Vol.Loading}" HorizontalAlignment="Center"
                     Foreground="{DynamicResource Gedaempft}" />
          <ProgressBar IsIndeterminate="True" Height="6" Width="220" Margin="0,10,0,0"
                       Background="{DynamicResource Feld}" Foreground="{DynamicResource Ein}" />
        </StackPanel>

        <TreeView x:Name="Tree" BorderThickness="0" Visibility="Collapsed">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
              <!-- Dreistufig: ein Verzeichnis, in dem manches lokal liegt und
                   manches nicht, ist weder das eine noch das andere. -->
              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        IsThreeState="True" VerticalAlignment="Center"
                        ToolTip="{DynamicResource S.Vol.BoxHint}" />
              <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Summary}" Margin="10,0,0,0"
                         Foreground="{DynamicResource Gedaempft}" VerticalAlignment="Center" />
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
        </TreeView>
      </Grid>
    </Border>
  </DockPanel>
</Window>
